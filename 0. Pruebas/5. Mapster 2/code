function getCityHeatmapGrid(monthDate) {
  const cache = CacheService.getScriptCache();
  const cacheKey = 'heatmap_' + monthDate.replace(/-/g, '');
  const cached = cache.get(cacheKey);
  if (cached) {
    return JSON.parse(cached);
  }

  const sql = `
    WITH coverage AS (
      SELECT
        cl.customer_id,
        ROUND(ST_Y(cl.customer_geogpoint) / 0.005) * 0.005 AS lat_bin,
        ROUND(ST_X(cl.customer_geogpoint) / 0.005) * 0.005 AS lon_bin
      FROM \`peya-food-and-groceries.automated_tables_reports.qc_coverage_customer_location\` cl
      WHERE cl.month_date = DATE '${monthDate}'
        AND cl.customer_geogpoint IS NOT NULL
    ),
    peya_gmv AS (
      SELECT
        o.user.user_id AS customer_id,
        SUM(o.gmv.gmv_user / monthly_rate_eu) AS gmv_peya
      FROM \`peya-datamarts-pro.dm_order_profitability.fact_order_profitability\` o
      WHERE DATE_TRUNC(o.registered_date, MONTH) = DATE '${monthDate}'
        AND o.order_status = 'CONFIRMED'
      GROUP BY 1
    ),
    dmart_gmv AS (
      SELECT
        CAST(co.customer_id AS STRING) AS customer_id,
        SUM(co.total_amount_net_with_discount_eur) AS gmv_dmart
      FROM \`peya-datamarts-pro.dm_dmarts.customer_orders_sku_level\` co
      WHERE DATE_TRUNC(co.order_date, MONTH) = DATE '${monthDate}'
        AND co.state = 'CONFIRMED'
      GROUP BY 1
    ),
    grid_raw AS (
      SELECT
        c.lat_bin,
        c.lon_bin,
        COUNT(DISTINCT c.customer_id) AS usuarios,
        SUM(COALESCE(p.gmv_peya, 0))  AS gmv_peya,
        SUM(COALESCE(d.gmv_dmart, 0)) AS gmv_dmart
      FROM coverage c
      LEFT JOIN peya_gmv  p ON CAST(c.customer_id AS STRING) = CAST(p.customer_id AS STRING)
      LEFT JOIN dmart_gmv d ON CAST(c.customer_id AS STRING) = d.customer_id
      GROUP BY 1, 2
    ),
    percentiles AS (
      SELECT
        PERCENTILE_CONT(usuarios, 0.97) OVER() AS p97_usuarios,
        PERCENTILE_CONT(gmv_peya, 0.97) OVER() AS p97_gmv_peya,
        PERCENTILE_CONT(gmv_dmart, 0.97) OVER() AS p97_gmv_dmart
      FROM grid_raw LIMIT 1
    )
    SELECT
      g.lat_bin,
      g.lon_bin,
      LEAST(g.usuarios, p.p97_usuarios) AS usuarios_capped,
      LEAST(g.gmv_peya, p.p97_gmv_peya) AS gmv_peya_capped,
      LEAST(g.gmv_dmart, p.p97_gmv_dmart) AS gmv_dmart_capped,
      SAFE_DIVIDE(LEAST(g.usuarios, p.p97_usuarios), p.p97_usuarios) AS weight_usuarios,
      SAFE_DIVIDE(LEAST(g.gmv_peya, p.p97_gmv_peya), p.p97_gmv_peya) AS weight_gmv_peya,
      SAFE_DIVIDE(LEAST(g.gmv_dmart, p.p97_gmv_dmart), p.p97_gmv_dmart) AS weight_gmv_dmart
    FROM grid_raw g
    CROSS JOIN percentiles p
  `;
  const result = runQuery(sql);
  
  try {
    const jsonStr = JSON.stringify(result);
    if (jsonStr.length < 100000) {
      cache.put(cacheKey, jsonStr, 21600);
    }
  } catch (e) {
    // Ignore cache size errors
  }
  
  return result;
}

