<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Store Explorer — City Penetration</title>
</head>
<body>

<!-- Incluir el Navbar y los estilos compartidos -->
<?!= include('_nav', { activePage: 'city', scriptUrl: scriptUrl }); ?>

<!-- ======================================================= -->
<!-- CONTENIDO: CITY PENETRATION -->
<!-- ======================================================= -->
<div id="tab-city" class="tab-content active" style="display:flex; flex-direction:column; flex:1;">
  <div class="kpi-group-title">Penetración y Comercial</div>
  <div class="kpi-section" id="city-kpi-group1"></div>
  <div class="kpi-group-title">Operación</div>
  <div class="kpi-section" id="city-kpi-group2"></div>

  <div class="main">
    <div class="map-card">
      <div class="card-header"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg> Mapa Nacional (Ciudades)</div>
      <div class="map-controls">
        <label><input type="radio" name="hm_layer" value="none" checked onchange="updateHeatmap()"> Sin Heatmap</label>
        <label><input type="radio" name="hm_layer" value="usuarios" onchange="updateHeatmap()"> Densidad Usuarios</label>
        <label><input type="radio" name="hm_layer" value="gmv_peya" onchange="updateHeatmap()"> GMV PeYa</label>
        <label><input type="radio" name="hm_layer" value="gmv_dmart" onchange="updateHeatmap()"> GMV Dmart</label>
      </div>
      <div id="city-map" class="map-container"></div>
    </div>
    <div class="table-card">
      <div class="card-header">Detalle por Ciudad</div>
      <div class="table-wrap">
        <table id="city-detail-table">
          <thead>
            <tr>
              <th onclick="sortCityTable('city_name_lz')">Ciudad</th>
              <th onclick="sortCityTable('users')">Users</th>
              <th onclick="sortCityTable('dmart_users')">Dmart Users</th>
              <th onclick="sortCityTable('penetration_pct')">Penetración %</th>
              <th onclick="sortCityTable('dmart_orders')">Órdenes</th>
              <th onclick="sortCityTable('dmart_net_sales')">Net Sales</th>
            </tr>
          </thead>
          <tbody id="city-table-body">
            <tr><td colspan="6"><div class="empty-state">Cargando...</div></td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
// ============================================================
// STATE & CONFIG
// ============================================================
let gMapCity;
let gCityMarkers = [], gCityHeatmap;
let cityData = [];
let cityGrid = [];
let citySortCol = 'users', citySortAsc = false;

// ============================================================
// INIT & NAVIGATION
// ============================================================
window.onload = function() {
  // Ajustar visibilidad de filtros comunes en el header
  document.getElementById('global-city-select').style.display = 'block';
  document.getElementById('global-month-select').style.display = 'block';

  try {
    initMaps();
  } catch(e) {
    console.error("Error al inicializar mapas en onload:", e);
  }
  loadGlobalFilters();
};

function initMaps() {
  try {
    if (typeof google === 'undefined' || !google.maps) {
      console.warn("Google Maps API no está disponible o la clave de API es incorrecta/inexistente.");
      return;
    }
    const mapOpts = { zoom: 5, center: { lat: -34.6, lng: -58.4 }, mapTypeId: 'roadmap', styles: darkMapStyle(), disableDefaultUI: false };
    gMapCity = new google.maps.Map(document.getElementById('city-map'), mapOpts);
    gCityHeatmap = null;
  } catch(e) {
    console.error("Error al inicializar google.maps.Map:", e);
  }
}

function loadGlobalFilters() {
  showLoading("Cargando ciudades...");
  google.script.run.withSuccessHandler(res => {
    populateSelect('global-city-select', res, 'city_name', 'city_name');
    hideLoading();
    loadCityData();
  }).getCityList();
}

function populateSelect(id, rows, valCol, textCol) {
  const sel = document.getElementById(id);
  sel.innerHTML = '<option value="">— Seleccionar —</option>';
  rows.forEach(r => {
    const opt = document.createElement('option');
    opt.value = r[valCol]; opt.textContent = r[textCol];
    sel.appendChild(opt);
  });
  if (rows.length > 0) sel.selectedIndex = 1;
}

function onGlobalFilterChange() {
  loadCityData();
}

// ============================================================
// DATA FETCHING & RENDERING (CITY)
// ============================================================
function loadCityData() {
  const city = document.getElementById('global-city-select').value;
  showLoading("Obteniendo datos de ciudad...");

  google.script.run.withSuccessHandler(months => {
    const mSel = document.getElementById('global-month-select');
    const curVal = mSel.value; mSel.innerHTML = '';
    months.forEach(m => { const o = document.createElement('option'); o.value = m.month_date; o.textContent = m.month_label; mSel.appendChild(o); });
    if (curVal && months.find(m => m.month_date === curVal)) mSel.value = curVal;
    
    const month = mSel.value;
    if (!month) { hideLoading(); return; }

    let p = 3; const d = () => { if(--p===0) hideLoading(); };
    google.script.run.withSuccessHandler(res => { if(res) renderCityKpis(res); d(); }).getCityKpis(city, month);
    google.script.run.withSuccessHandler(res => { cityData = res; renderCityTable(); drawCityMapMarkers(); d(); }).getAllCitiesForMap(month);
    google.script.run.withSuccessHandler(res => { cityGrid = res; updateHeatmap(); d(); }).getCityHeatmapGrid(month);
  }).getAvailableMonthsCity();
}

const CITY_KPI_CONFIG = [
  // Group 1
  { id: 'users', label: 'Covered Users', fmt: fmt, g: 1 },
  { id: 'dmart_users', label: 'Dmart MAUs', fmt: fmt, g: 1 },
  { id: 'penetration_pct', label: 'Penetración %', fmt: fmtPct, g: 1 },
  { id: 'core_users_pct', label: 'Core Users %', fmt: fmtPct, g: 1 },
  { id: 'high_users_pct', label: 'High Users %', fmt: fmtPct, g: 1 },
  { id: 'plus_maus_pct', label: 'Plus MAUs %', fmt: fmtPct, g: 1 },
  { id: 'market_users', label: 'Market Users', fmt: fmt, g: 1 },
  { id: 'gpo', label: 'GPO', fmt: fmtEur, g: 1 },
  { id: 'customer_value', label: 'Customer Value', fmt: fmtEur, g: 1 },
  { id: 'aov', label: 'AOV', fmt: fmtEur, g: 1 },
  { id: 'afv_wo_vat', label: 'AFV wo VAT', fmt: fmtEur, g: 1 },
  { id: 'cvr3_pct', label: 'CVR3 %', fmt: fmtPct, g: 1 },
  { id: 'dmart_orders_share_pct', label: 'Dmart Orders %', fmt: fmtPct, g: 1 },
  { id: 'dmart_freq', label: 'Dmart Freq', fmt: v=>(parseFloat(v)||0).toFixed(2), g: 1 },
  // Group 2
  { id: 'rider_cost', label: 'Rider Cost', fmt: fmtEur, g: 2 },
  { id: 'avg_delivery_distance_km', label: 'Avg Dist (km)', fmt: v=>(parseFloat(v)||0).toFixed(2), g: 2 },
  { id: 'avg_delivery_time_min', label: 'Avg DT (min)', fmt: v=>(parseFloat(v)||0).toFixed(1), g: 2 },
  { id: 'order_late_pct', label: 'Order Late >10%', fmt: fmtPct, g: 2 },
  { id: 'vendor_late_pct', label: 'Vendor Late >10%', fmt: fmtPct, g: 2 },
  { id: 'uf_users', label: 'UF Users', fmt: fmt, g: 2 },
  { id: 'uf_basket_penetration_pct', label: 'UF Basket %', fmt: fmtPct, g: 2 },
  { id: 'basket_size', label: 'Basket Size', fmt: v=>(parseFloat(v)||0).toFixed(1), g: 2 }
];

function renderCityKpis(row) {
  const g1 = document.getElementById('city-kpi-group1'); g1.innerHTML = '';
  const g2 = document.getElementById('city-kpi-group2'); g2.innerHTML = '';
  CITY_KPI_CONFIG.forEach(k => {
    const html = `<div class="kpi-card"><div class="kpi-label">${k.label}</div><div class="kpi-value">${k.fmt(row[k.id])}</div></div>`;
    if (k.g === 1) g1.innerHTML += html; else g2.innerHTML += html;
  });
}

function updateHeatmap() {
  if (!gMapCity) return;
  const type = document.querySelector('input[name="hm_layer"]:checked').value;
  if (gCityHeatmap) {
    gCityHeatmap.setMap(null);
    gCityHeatmap = null;
  }
  if (type === 'none' || !cityGrid.length) return;

  const dataPoints = cityGrid.map(r => ({
    latitude: parseFloat(r.lat_bin),
    longitude: parseFloat(r.lon_bin),
    weight: parseFloat(r['weight_' + type]) || 0
  })).filter(pt => pt.weight > 0);

  const heatmapLayer = new deck.HeatmapLayer({
    id: 'heatmap-layer',
    data: dataPoints,
    getPosition: d => [d.longitude, d.latitude],
    getWeight: d => d.weight,
    radiusPixels: 35,
    intensity: 2,
    threshold: 0.05
  });

  gCityHeatmap = new deck.GoogleMapsOverlay({
    layers: [heatmapLayer]
  });
  gCityHeatmap.setMap(gMapCity);
}

function drawCityMapMarkers() {
  if (!gMapCity) {
    console.warn("gMapCity no está inicializado. Se omite el dibujo de marcadores de ciudad.");
    return;
  }
  gCityMarkers.forEach(m => m.setMap(null)); gCityMarkers = [];
  cityData.forEach(r => {
    const m = new google.maps.Marker({ position: {lat: parseFloat(r.lat_centro), lng: parseFloat(r.lon_centro)}, map: gMapCity, title: r.city_name_lz });
    const iw = new google.maps.InfoWindow({ content: `<b>${r.city_name_lz}</b><br>Users: ${fmt(r.users)}<br>Pen: ${fmtPct(r.penetration_pct)}` });
    m.addListener('click', () => iw.open(gMapCity, m));
    gCityMarkers.push(m);
  });
}

function sortCityTable(col) {
  if (citySortCol === col) citySortAsc = !citySortAsc; else { citySortCol = col; citySortAsc = false; }
  renderCityTable();
}

function renderCityTable() {
  const tbody = document.getElementById('city-table-body'); tbody.innerHTML = '';
  const data = [...cityData].sort((a,b) => {
    let va = parseFloat(a[citySortCol])||0, vb = parseFloat(b[citySortCol])||0;
    if(citySortCol==='city_name_lz') { va=a[citySortCol]; vb=b[citySortCol]; return citySortAsc ? va.localeCompare(vb) : vb.localeCompare(va); }
    return citySortAsc ? va - vb : vb - va;
  });
  data.forEach(r => {
    tbody.innerHTML += `<tr><td>${r.city_name_lz}</td><td>${fmt(r.users)}</td><td>${fmt(r.dmart_users)}</td><td>${fmtPct(r.penetration_pct)}</td><td>${fmt(r.dmart_orders)}</td><td>${fmtEur(r.customer_value)}</td></tr>`;
  });
}

function darkMapStyle() { return [ { featureType: 'poi', stylers: [{ visibility: 'off' }] }, { featureType: 'transit', stylers: [{ visibility: 'off' }] }, { featureType: 'road', elementType: 'geometry', stylers: [{ color: '#f5f3f7' }] }, { featureType: 'road', elementType: 'geometry.stroke', stylers: [{ color: '#E4E2E9' }] }, { featureType: 'road.arterial', elementType: 'labels.text.fill', stylers: [{ color: '#70697A' }] }, { featureType: 'road.highway', elementType: 'geometry', stylers: [{ color: '#EDE9F2' }] }, { featureType: 'water', elementType: 'geometry', stylers: [{ color: '#C8D8F0' }] }, { featureType: 'water', elementType: 'labels.text.fill', stylers: [{ color: '#4C4359' }] }, { featureType: 'landscape', elementType: 'geometry', stylers: [{ color: '#F7F5FA' }] }, { elementType: 'labels.text.fill', stylers: [{ color: '#4C4359' }] }, { elementType: 'labels.text.stroke', stylers: [{ color: '#ffffff' }] }, { featureType: 'administrative', elementType: 'geometry.stroke', stylers: [{ color: '#D0CDD8' }] } ]; }
</script>
</body>
</html>