function toggleColPicker(evt) {
  evt.stopPropagation();
  const panel = document.getElementById('col-picker-panel');
  const opening = panel.style.display === 'none';
  if (opening) { renderColPicker(); panel.style.display = 'block'; }
  else { panel.style.display = 'none'; }
}
document.addEventListener('click', (e) => {
  const panel = document.getElementById('col-picker-panel');
  const wrap = e.target.closest && e.target.closest('.col-picker-wrap');
  if (panel && panel.style.display !== 'none' && !wrap) panel.style.display = 'none';
});

function renderColPicker() {
  const panel = document.getElementById('col-picker-panel');
  let html = `<div class="col-picker-actions">
    <button onclick="marketColsSelectAll()">Seleccionar todas</button>
    <button onclick="marketColsReset()">Restablecer default</button>
  </div>`;
  [1, 2, 3].forEach(g => {
    html += `<div class="col-picker-group-title">${MARKET_GROUP_LABELS[g]}</div>`;
    MARKET_COLS.filter(c => c.g === g).forEach(c => {
      const checked = marketVisibleCols.has(c.id) ? 'checked' : '';
      html += `<label class="col-picker-item"><input type="checkbox" ${checked} onchange="onMarketColToggle('${c.id}')"> ${c.label}</label>`;
    });
  });
  panel.innerHTML = html;
  document.getElementById('col-picker-count').textContent = marketVisibleCols.size;
}

function onMarketColToggle(id) {
  if (marketVisibleCols.has(id)) marketVisibleCols.delete(id); else marketVisibleCols.add(id);
  document.getElementById('col-picker-count').textContent = marketVisibleCols.size;
  renderMarketTable();
}
function marketColsSelectAll() {
  MARKET_COLS.forEach(c => marketVisibleCols.add(c.id));
  renderColPicker(); renderMarketTable();
}
function marketColsReset() {
  marketVisibleCols = new Set([
    'users', 'dmart_users', 'penetration_pct', 'customer_value', 'aov', 'dmart_orders_share_pct',
    'avg_delivery_time_min', 'order_late_pct', 'seamless_rate_pct', 'fail_rate_pct', 'avg_assignment_time_min'
  ]);
  renderColPicker(); renderMarketTable();
}

function renderMarketTable() {
  const thead = document.getElementById('market-table-head');
  const tbody = document.getElementById('market-table-body');

  const cols = MARKET_COLS.filter(c => marketVisibleCols.has(c.id));
  const mainCol = marketView === 'evolution' ? 'month_label' : 'warehouse_name';
  const countEl = document.getElementById('col-picker-count');
  if (countEl) countEl.textContent = marketVisibleCols.size;

  if (!cols.length) {
    thead.innerHTML = '';
    tbody.innerHTML = `<tr><td><div class="empty-state">Elegí al menos una métrica para mostrar</div></td></tr>`;
    return;
  }

  let hHtml = `<tr><th onclick="sortMarketTable('${mainCol}')">${marketView==='evolution'?'Mes':'Warehouse'}</th>`;
  cols.forEach(c => hHtml += `<th class="th-group-${c.g===1?'pen':c.g===2?'ops':'sea'}" onclick="sortMarketTable('${c.id}')">${c.label}</th>`);
  hHtml += '</tr>'; thead.innerHTML = hHtml;

  const data = [...marketData].sort((a,b) => {
    let va = a[marketSortCol], vb = b[marketSortCol];
    if(typeof va === 'string') {
      if (va === 'No disponible' || va === 'cargando...') return 1;
      if (vb === 'No disponible' || vb === 'cargando...') return -1;
      return marketSortAsc ? va.localeCompare(vb) : vb.localeCompare(va);
    }
    return marketSortAsc ? (parseFloat(va)||0) - (parseFloat(vb)||0) : (parseFloat(vb)||0) - (parseFloat(va)||0);
  });

  tbody.innerHTML = data.map(r => {
    let tr = `<tr><td>${r[mainCol]}</td>`;
    cols.forEach(c => tr += `<td>${c.fmt(r[c.id])}</td>`);
    return tr + '</tr>';
  }).join('');
}
function sortMarketTable(col) {
  if (marketSortCol === col) marketSortAsc = !marketSortAsc; else { marketSortCol = col; marketSortAsc = false; }
  renderMarketTable();
}

function SAFE_DIVIDE(numerator, denominator) {
  if (denominator === 0 || isNaN(denominator) || !isFinite(denominator)) return 0;
  return numerator / denominator;
}

function renderMarketKpis(data) {
  const seamlessCard = document.getElementById('kpi-seamless-delivery');
  const avgDtCard = document.getElementById('kpi-avg-delivery-time');
  const rejectedCard = document.getElementById('kpi-rejected-orders');
  const hcSessionCard = document.getElementById('kpi-hc-sessions-orders');

  const isSeamlessAvailable = data && data.length > 0 && data.some(r => r.seamless_rate_pct !== null && typeof r.seamless_rate_pct !== 'undefined' && r.seamless_rate_pct !== 'No disponible');
  const isAvgDtAvailable = data && data.length > 0 && data.some(r => r.avg_delivery_time_min !== null && typeof r.avg_delivery_time_min !== 'undefined');

  // Toggle visibility based on data availability
  seamlessCard.querySelector('.kpi-value').style.display = isSeamlessAvailable ? 'block' : 'none';
  seamlessCard.querySelector('.kpi-unavailable').style.display = isSeamlessAvailable ? 'none' : 'block';
  rejectedCard.querySelector('.kpi-value').style.display = isSeamlessAvailable ? 'block' : 'none';
  rejectedCard.querySelector('.kpi-unavailable').style.display = isSeamlessAvailable ? 'none' : 'block';
  
  avgDtCard.querySelector('.kpi-value').style.display = isAvgDtAvailable ? 'block' : 'none';
  avgDtCard.querySelector('.kpi-unavailable').style.display = isAvgDtAvailable ? 'none' : 'block';
  avgDtCard.querySelector('.kpi-unavailable').textContent = 'cargando...';

  // HC Sessions is always unavailable as the metric doesn't exist in the data
  hcSessionCard.querySelector('.kpi-value').style.display = 'none';
  hcSessionCard.querySelector('.kpi-unavailable').style.display = 'block';

  if (isSeamlessAvailable) {
    const totalOrders = data.reduce((sum, r) => sum + (parseFloat(r.dmart_orders) || 0), 0);

    const weightedSeamlessSum = data.reduce((sum, r) => sum + (parseFloat(r.seamless_rate_pct) || 0) * (parseFloat(r.dmart_orders) || 0), 0);
    seamlessCard.querySelector('.kpi-value').textContent = fmtPct(SAFE_DIVIDE(weightedSeamlessSum, totalOrders));

    const weightedRejectedSum = data.reduce((sum, r) => sum + (parseFloat(r.fail_rate_pct) || 0) * (parseFloat(r.dmart_orders) || 0), 0);
    rejectedCard.querySelector('.kpi-value').textContent = fmtPct(SAFE_DIVIDE(weightedRejectedSum, totalOrders));
  }
  
  if (isAvgDtAvailable) {
    const totalOrdersWithTime = data.reduce((sum, r) => sum + (parseFloat(r.total_orders_timings) || parseFloat(r.dmart_orders) || 0), 0);
    const weightedDtSum = data.reduce((sum, r) => sum + (parseFloat(r.avg_delivery_time_min) || 0) * (parseFloat(r.total_orders_timings) || parseFloat(r.dmart_orders) || 0), 0);
    avgDtCard.querySelector('.kpi-value').textContent = SAFE_DIVIDE(weightedDtSum, totalOrdersWithTime).toFixed(1) + ' min';
  }
}

function drawMarketMap(rows) {
  gMarketMarkers.forEach(m => m.setMap(null)); gMarketMarkers = [];
  gMarketPolygons.forEach(p => p.setMap(null)); gMarketPolygons = [];
  rows.forEach(r => {
    const m = new google.maps.Marker({ position: {lat: parseFloat(r.store_lat), lng: parseFloat(r.store_lng)}, map: gMapMarket, title: r.warehouse_name });
    const iw = new google.maps.InfoWindow({ content: `<b>${r.warehouse_name}</b><br>Pen: ${fmtPct(r.penetration_pct)}` });
    m.addListener('click', () => iw.open(gMapMarket, m));
    gMarketMarkers.push(m);
    
    try {
      const shape = JSON.parse(r.shape_geojson);
      const paths = (shape.type === 'Polygon') ? shape.coordinates.map(rg=>rg.map(c=>({lat:c[1],lng:c[0]}))) : shape.coordinates.flatMap(p=>p.map(rg=>rg.map(c=>({lat:c[1],lng:c[0]}))));
      gMarketPolygons.push(new google.maps.Polygon({ paths, strokeColor: '#B40443', strokeOpacity: 0.5, strokeWeight: 1, fillColor: '#EA044E', fillOpacity: 0.05, map: gMapMarket }));
    } catch(e){}
  });
}

