function fmt(n) { if (n === 'No disponible') return n; const v = parseFloat(n) || 0; return v >= 1e6 ? (v/1e6).toFixed(1)+'M' : v >= 1e3 ? (v/1e3).toFixed(1)+'K' : v.toLocaleString('es-AR'); }
function fmtPct(n) { if (n === 'No disponible') return n; return (parseFloat(n) || 0).toFixed(1) + '%'; }
function fmtEur(n) { if (n === 'No disponible') return n; const v = parseFloat(n) || 0; return '€' + (v >= 1e6 ? (v/1e6).toFixed(1)+'M' : v >= 1e3 ? (v/1e3).toFixed(1)+'K' : v.toFixed(0)); }

function processMarketData(res) {
  if (!res || !res.length) return res;
  
  // 1. Identificar qué países tienen al menos una fila con seamless_rate_pct >= 100
  const countriesWith100Seamless = new Set();
  res.forEach(r => {
    const country = r.country_name || r.Country_en || r.country_code || r.country;
    const seamlessRate = parseFloat(r.seamless_rate_pct);
    if (country && !isNaN(seamlessRate) && seamlessRate >= 100) {
      countriesWith100Seamless.add(country.toLowerCase().trim());
    }
  });

  // 2. Para esos países, marcar las métricas de fricción de seamless como 'No disponible'
  const metricsToBlock = [
    'fail_rate_pct', 'forced_preorder_pct', 'modified_order_pct',
    'session_order_pct', 'slow_order_pct', 'late_order_seamless_pct',
    'rejected_orders', 'forced_pre_orders', 'modified_orders',
    'session_orders', 'slow_orders', 'order_late_ops'
  ];

  return res.map(r => {
    const country = r.country_name || r.Country_en || r.country_code || r.country;
    if (country) {
      const normalizedCountry = country.toLowerCase().trim();
      if (countriesWith100Seamless.has(normalizedCountry)) {
        const newRow = { ...r };
        metricsToBlock.forEach(metric => {
          if (metric in newRow) {
            newRow[metric] = 'No disponible';
          }
        });
        return newRow;
      }
    }
    return r;
  });
}

function showLoading(msg) { document.getElementById('loading-msg').textContent = msg || 'Cargando…'; document.getElementById('loading-overlay').style.display = 'flex'; }
function hideLoading() { document.getElementById('loading-overlay').style.display = 'none'; }
function showError(e) { console.error(e); document.getElementById('loading-msg').textContent = '⚠ Error: ' + (e.message || e); setTimeout(hideLoading, 3000); }

