window.onload = function() {
  initMaps();
  loadGlobalFilters();
};

function initMaps() {
  const mapOpts = { zoom: 12, center: { lat: -34.6, lng: -58.4 }, mapTypeId: 'roadmap', styles: darkMapStyle(), disableDefaultUI: false };
  gMapRings = new google.maps.Map(document.getElementById('rings-map'), mapOpts);
  gMapCity = new google.maps.Map(document.getElementById('city-map'), { ...mapOpts, zoom: 5 });
  gMapMarket = new google.maps.Map(document.getElementById('market-map'), { ...mapOpts, zoom: 5 });
  gCityHeatmap = null;
}

function loadGlobalFilters() {
  // Parallel loading of lists
  let pending = 2;
  const done = () => { if (--pending === 0) { hideLoading(); switchTab('rings'); } };
  
  google.script.run.withSuccessHandler(res => {
    populateSelect('global-warehouse-select', res, 'warehouse_id', 'warehouse_name');
    done();
  }).getWarehouseList();

  google.script.run.withSuccessHandler(res => {
    populateSelect('global-city-select', res, 'city_name', 'city_name');
    done();
  }).getCityList();
}

function populateSelect(id, rows, valCol, textCol) {
  const sel = document.getElementById(id);
  sel.innerHTML = '<option value="">— Seleccionar —</option>';
  rows.forEach(r => {
    const opt = document.createElement('option');
    opt.value = r[valCol]; opt.textContent = r[textCol];
    sel.appendChild(opt);
  });
  if (rows.length > 0) sel.selectedIndex = 1;
}

function switchTab(tab, btn) {
  if (btn) {
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
  }
  document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
  document.getElementById('tab-' + tab).classList.add('active');
  activeTab = tab;

  // Setup header selectors based on tab
  const wSel = document.getElementById('global-warehouse-select');
  const cSel = document.getElementById('global-city-select');
  const mSel = document.getElementById('global-month-select');

  wSel.style.display = (tab === 'rings' || (tab === 'market' && marketView === 'evolution')) ? 'block' : 'none';
  cSel.style.display = tab === 'city' ? 'block' : 'none';
  mSel.style.display = (tab === 'rings' || tab === 'city' || (tab === 'market' && marketView === 'benchmark')) ? 'block' : 'none';

  loadTabData();
}

function onGlobalFilterChange() {
  loadTabData();
}

function loadTabData() {
  if (activeTab === 'rings') loadRingsData();
  else if (activeTab === 'city') loadCityData();
  else if (activeTab === 'market') loadMarketData();
}

