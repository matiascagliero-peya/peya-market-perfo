<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Store Explorer</title>

<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<!-- Google Maps API -->
<script src="https://maps.googleapis.com/maps/api/js?key=code"></script>
<!-- deck.gl CDN for high-performance WebGL Heatmaps (Official Migration Path) -->
<script src="https://unpkg.com/deck.gl@latest/dist.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<style>
  /* ── Reset & base ── */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --red-70:    #B40443;
    --red-50:    #EA044E;
    --red-40:    #EC1D60;
    --red-20:    #F481A6;
    --navy-90:   #100423;
    --navy-70:   #4C4359;
    --navy-60:   #70697A;
    --bg:        #F7F7F9;
    --surface:   #FFFFFF;
    --surface2:  #F2F1F4;
    --border:    #E4E2E9;
    --accent:    var(--red-50);
    --text:      var(--navy-90);
    --muted:     var(--navy-60);
    --subtle:    var(--navy-70);
    --green:     #0E7C4A;
    --green-bg:  #D6F5E7;
    --yellow:    #7A5900;
    --yellow-bg: #FFF0C2;
    --red-status:    #B40443;
    --red-status-bg: #FCE0EB;
    --radius:    12px;
    --shadow:    0 2px 12px rgba(16,4,35,0.08);
    --shadow-lg: 0 4px 24px rgba(16,4,35,0.12);
  }

  body {
    font-family: 'Outfit', system-ui, sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  /* ── Header ── */
  .header {
    background: var(--navy-90);
    padding: 14px 24px;
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .header-title {
    font-size: 18px;
    font-weight: 700;
    color: #fff;
    margin-right: auto;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .header-title .logo-dot {
    width: 10px; height: 10px;
    background: var(--red-50);
    border-radius: 50%;
    display: inline-block;
  }

  select {
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.2);
    color: #fff;
    padding: 8px 14px;
    border-radius: 8px;
    font-size: 14px;
    font-family: 'Outfit', sans-serif;
    font-weight: 500;
    cursor: pointer;
    outline: none;
    min-width: 200px;
  }
  select:hover { border-color: var(--red-40); background: rgba(255,255,255,0.15); }
  select option { background: var(--navy-90); color: #fff; }

  /* ── Tabs ── */
  .tabs-bar {
    background: var(--navy-90);
    padding: 0 24px;
    display: flex;
    gap: 24px;
    box-shadow: var(--shadow-lg);
  }
  .tab-btn {
    background: none;
    border: none;
    color: rgba(255,255,255,0.6);
    font-size: 14px;
    font-family: 'Outfit', sans-serif;
    font-weight: 600;
    padding: 12px 0;
    cursor: pointer;
    border-bottom: 3px solid transparent;
    transition: all 0.2s;
  }
  .tab-btn:hover { color: #fff; }
  .tab-btn.active { color: #fff; border-bottom-color: var(--red-50); }

  .tab-content { display: none; flex: 1; flex-direction: column; }
  .tab-content.active { display: flex; }

  /* ── Loading ── */
  #loading-overlay {
    position: fixed; inset: 0; background: rgba(16,4,35,0.6); backdrop-filter: blur(4px);
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    z-index: 9999; gap: 16px;
  }
  .spinner {
    width: 44px; height: 44px; border: 3px solid rgba(255,255,255,0.15);
    border-top-color: var(--red-50); border-radius: 50%; animation: spin 0.8s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  #loading-overlay p { color: rgba(255,255,255,0.7); font-size: 14px; }

  /* ── KPI cards ── */
  .kpi-group-title {
    padding: 20px 24px 0;
    font-size: 14px;
    font-weight: 700;
    color: var(--navy-70);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .kpi-section {
    padding: 12px 24px 20px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 16px;
  }
  .kpi-card {
    background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);
    padding: 16px; display: flex; flex-direction: column; gap: 4px; box-shadow: var(--shadow);
    position: relative; overflow: hidden;
  }
  .kpi-card::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
    background: linear-gradient(90deg, #B40443, var(--red-40));
  }
  .kpi-label { font-size: 11px; text-transform: uppercase; letter-spacing: 0.09em; color: var(--muted); font-weight: 600; }
  .kpi-value { font-size: 24px; font-weight: 800; color: var(--navy-90); line-height: 1.1; }
  .kpi-trend { font-size: 12px; font-weight: 500; color: var(--muted); }
  .kpi-trend.up { color: var(--green); }
  .kpi-trend.down { color: var(--red-status); }
  .kpi-chart-wrap { height: 40px; margin-top: 8px; }

  /* ── Main body ── */
  .main { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; padding: 16px 24px; flex: 1; min-height: 0; }
  .main-full { display: flex; flex-direction: column; gap: 16px; padding: 16px 24px; flex: 1; min-height: 0; }

  .map-card, .table-card, .chart-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow); }
  .map-card { overflow: hidden; display: flex; flex-direction: column; position: relative; }
  .card-header { padding: 12px 16px; font-size: 13px; font-weight: 600; color: var(--subtle); border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 8px; background: var(--surface2); }
  .card-header svg { color: var(--red-50); }
  
  .map-container { flex: 1; min-height: 420px; width: 100%; }
  
  /* Map Controls Overlay */
  .map-controls {
    position: absolute; top: 50px; right: 10px; background: rgba(16,4,35,0.85); padding: 10px; border-radius: 8px;
    color: #fff; font-size: 12px; display: flex; flex-direction: column; gap: 8px; z-index: 10;
  }
  .map-controls label { display: flex; align-items: center; gap: 6px; cursor: pointer; }

  /* ── Tables ── */
  .table-card { display: flex; flex-direction: column; overflow: hidden; }
  .table-wrap { overflow: auto; flex: 1; max-height: 600px; }
  table { width: 100%; border-collapse: collapse; font-size: 13px; font-family: 'Outfit', sans-serif; }
  thead th {
    background: var(--surface2); color: var(--muted); font-size: 10px; font-weight: 700;
    text-transform: uppercase; padding: 10px 14px; text-align: right; white-space: nowrap;
    border-bottom: 1px solid var(--border); position: sticky; top: 0; z-index: 2; cursor: pointer;
  }
  thead th:first-child { text-align: left; left: 0; z-index: 3; }
  thead th.th-group-pen { border-top: 3px solid var(--red-50); }
  thead th.th-group-ops { border-top: 3px solid var(--navy-60); }
  thead th.th-group-sea { border-top: 3px solid #7A5900; }

  tbody tr { border-bottom: 1px solid var(--border); transition: background 0.12s; cursor: pointer; }
  tbody tr:hover { background: var(--surface2); }
  tbody tr.active { background: #FCE0EB; border-left: 3px solid var(--red-50); }
  td { padding: 10px 14px; text-align: right; white-space: nowrap; color: var(--navy-70); font-weight: 400; }
  td:first-child { text-align: left; font-weight: 600; color: var(--navy-90); position: sticky; left: 0; background: inherit; z-index: 1; }
  
  .badge { display: inline-block; padding: 2px 9px; border-radius: 99px; font-size: 11px; font-weight: 700; }
  .badge-green { background: var(--green-bg); color: var(--green); }
  .badge-yellow { background: var(--yellow-bg); color: var(--yellow); }
  .badge-red { background: var(--red-status-bg); color: var(--red-status); }
  .badge-gray { background: var(--surface2); color: var(--muted); }

  /* ── Charts ── */
  .chart-section { padding: 0 24px 20px; }
  .chart-card { padding: 16px 20px; }
  .chart-controls { display: flex; align-items: center; gap: 8px; margin-bottom: 14px; flex-wrap: wrap; }
  .chart-title { font-size: 13px; font-weight: 700; color: var(--navy-70); margin-right: auto; text-transform: uppercase; }
  .metric-btn { background: var(--surface2); border: 1px solid var(--border); color: var(--muted); padding: 5px 13px; border-radius: 6px; font-size: 12px; cursor: pointer; transition: all 0.15s; font-weight: 500; font-family: 'Outfit';}
  .metric-btn:hover { border-color: var(--red-40); color: var(--navy-90); }
  .metric-btn.active { background: var(--red-50); border-color: var(--red-50); color: #fff; font-weight: 600; }
  .bar-chart-wrap { height: 200px; }
  .empty-state { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; min-height: 200px; color: var(--muted); gap: 8px; font-size: 14px; }

  /* ── View Toggle for Market ── */
  .view-toggle { display: flex; gap: 8px; margin-bottom: 16px; position: relative; }
  .view-btn { padding: 8px 16px; border-radius: 20px; border: 1px solid var(--border); background: var(--surface); cursor: pointer; font-size: 13px; font-family: 'Outfit'; font-weight: 600; color: var(--muted); }
  .view-btn.active { background: var(--navy-90); color: #fff; border-color: var(--navy-90); }

  /* ── Column picker ── */
  .col-picker-wrap { position: relative; margin-left: auto; }
  .col-picker-btn { padding: 8px 14px; border-radius: 8px; border: 1px solid var(--border); background: var(--surface); cursor: pointer; font-size: 13px; font-family: 'Outfit'; font-weight: 600; color: var(--navy-90); display: flex; align-items: center; gap: 6px; }
  .col-picker-btn:hover { border-color: var(--red-40); }
  .col-picker-panel { position: absolute; top: calc(100% + 6px); right: 0; z-index: 50; background: var(--surface); border: 1px solid var(--border); border-radius: 12px; box-shadow: var(--shadow-lg); padding: 14px; width: 340px; max-height: 420px; overflow-y: auto; }
  .col-picker-actions { display: flex; gap: 8px; margin-bottom: 10px; padding-bottom: 10px; border-bottom: 1px solid var(--border); }
  .col-picker-actions button { flex: 1; padding: 5px 8px; border-radius: 6px; border: 1px solid var(--border); background: var(--surface2); color: var(--navy-90); font-size: 11px; font-family: 'Outfit'; font-weight: 600; cursor: pointer; }
  .col-picker-actions button:hover { border-color: var(--red-40); }
  .col-picker-group-title { font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--muted); margin: 10px 0 6px; }
  .col-picker-group-title:first-child { margin-top: 0; }
  .col-picker-item { display: flex; align-items: center; gap: 8px; padding: 4px 2px; font-size: 13px; color: var(--text); cursor: pointer; border-radius: 6px; }
  .col-picker-item:hover { background: var(--surface2); }
  .col-picker-item input { accent-color: var(--red-50); cursor: pointer; }
  .th-group-pen { border-bottom: 2px solid var(--red-40); }
  .th-group-ops { border-bottom: 2px solid var(--navy-70); }
  .th-group-sea { border-bottom: 2px solid var(--yellow); }
</style>
</head>
<body>

<div id="loading-overlay"><div class="spinner"></div><p id="loading-msg">Cargando…</p></div>

<div class="header">
  <div class="header-title"><span class="logo-dot"></span> Store Explorer</div>
  <select id="global-warehouse-select" onchange="onGlobalFilterChange()" style="display:none"></select>
  <select id="global-city-select" onchange="onGlobalFilterChange()" style="display:none"></select>
  <select id="global-month-select" onchange="onGlobalFilterChange()"></select>
</div>

<div class="tabs-bar">
  <button class="tab-btn active" onclick="switchTab('rings', this)">Store Penetration by Rings</button>
  <button class="tab-btn" onclick="switchTab('city', this)">City Penetration</button>
  <button class="tab-btn" onclick="switchTab('market', this)">Market Penetration</button>
</div>

<!-- ======================================================= -->
<!-- TAB 1: RINGS -->
<!-- ======================================================= -->
<div id="tab-rings" class="tab-content active">
  <div class="kpi-group-title">KPIs Tendencia (Últimos 6 meses)</div>
  <div class="kpi-section" id="rings-kpi-section">
    <div class="kpi-card">
      <div class="kpi-label">Covered MAUs</div><div class="kpi-value" id="ring-kpi-covered">—</div>
      <div class="kpi-trend" id="ring-kpi-covered-trend"></div>
      <div class="kpi-chart-wrap"><canvas id="ring-chart-covered"></canvas></div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">Dmart Covered MAUs</div><div class="kpi-value" id="ring-kpi-dmart">—</div>
      <div class="kpi-trend" id="ring-kpi-dmart-trend"></div>
      <div class="kpi-chart-wrap"><canvas id="ring-chart-dmart"></canvas></div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">Penetración MAUs</div><div class="kpi-value" id="ring-kpi-penetration">—</div>
      <div class="kpi-trend" id="ring-kpi-penetration-trend"></div>
      <div class="kpi-chart-wrap"><canvas id="ring-chart-penetration"></canvas></div>
    </div>
  </div>

  <div class="main">
    <div class="map-card">
      <div class="card-header"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg> Mapa de cobertura</div>
      <div id="rings-map" class="map-container"></div>
    </div>
    <div class="table-card">
      <div class="card-header"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/><line x1="12" y1="3" x2="12" y2="21"/></svg> Métricas por anillo</div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Anillo</th><th>Covered MAUs</th><th>Dmart MAUs</th><th>Penetración</th>
              <th>Órdenes</th><th>Net Sales</th><th>Avg DT</th><th>% Late</th>
            </tr>
          </thead>
          <tbody id="rings-table-body">
            <tr><td colspan="8"><div class="empty-state">Seleccioná una tienda</div></td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="chart-section">
    <div class="chart-card">
      <div class="chart-controls">
        <span class="chart-title">Distribución por anillo</span>
        <button class="metric-btn active" onclick="switchMetric('rings', 'covered_maus', this)">Covered MAUs</button>
        <button class="metric-btn" onclick="switchMetric('rings', 'dmart_maus', this)">Dmart MAUs</button>
        <button class="metric-btn" onclick="switchMetric('rings', 'penetration', this)">Penetración %</button>
        <button class="metric-btn" onclick="switchMetric('rings', 'orders', this)">Órdenes</button>
        <button class="metric-btn" onclick="switchMetric('rings', 'net_sales', this)">Net Sales</button>
        <button class="metric-btn" onclick="switchMetric('rings', 'avg_dt', this)">Avg DT</button>
      </div>
      <div class="bar-chart-wrap"><canvas id="rings-bar-chart"></canvas></div>
    </div>
  </div>
</div>

<!-- ======================================================= -->
<!-- TAB 2: CITY PENETRATION -->
<!-- ======================================================= -->
<div id="tab-city" class="tab-content">
  <div class="kpi-group-title">Penetración y Comercial</div>
  <div class="kpi-section" id="city-kpi-group1"></div>
  <div class="kpi-group-title">Operación</div>
  <div class="kpi-section" id="city-kpi-group2"></div>

  <div class="main">
    <div class="map-card">
      <div class="card-header"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg> Mapa Nacional (Ciudades)</div>
      <div class="map-controls">
        <label><input type="radio" name="hm_layer" value="none" checked onchange="updateHeatmap()"> Sin Heatmap</label>
        <label><input type="radio" name="hm_layer" value="usuarios" onchange="updateHeatmap()"> Densidad Usuarios</label>
        <label><input type="radio" name="hm_layer" value="gmv_peya" onchange="updateHeatmap()"> GMV PeYa</label>
        <label><input type="radio" name="hm_layer" value="gmv_dmart" onchange="updateHeatmap()"> GMV Dmart</label>
      </div>
      <div id="city-map" class="map-container"></div>
    </div>
    <div class="table-card">
      <div class="card-header">Detalle por Ciudad</div>
      <div class="table-wrap">
        <table id="city-detail-table">
          <thead>
            <tr>
              <th onclick="sortCityTable('city_name_lz')">Ciudad</th>
              <th onclick="sortCityTable('users')">Users</th>
              <th onclick="sortCityTable('dmart_users')">Dmart Users</th>
              <th onclick="sortCityTable('penetration_pct')">Penetración %</th>
              <th onclick="sortCityTable('dmart_orders')">Órdenes</th>
              <th onclick="sortCityTable('dmart_net_sales')">Net Sales</th>
            </tr>
          </thead>
          <tbody id="city-table-body">
            <tr><td colspan="6"><div class="empty-state">Cargando...</div></td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- ======================================================= -->
<!-- TAB 3: MARKET PENETRATION -->
<!-- ======================================================= -->
<div id="tab-market" class="tab-content">
  <div class="kpi-section" id="market-kpi-section" style="padding-bottom: 0;">
    <div class="kpi-card" id="kpi-seamless-delivery">
      <div class="kpi-label">Seamless Delivery %</div>
      <div class="kpi-value">--</div>
      <div class="kpi-unavailable" style="display: none;">
        <div style="font-weight: 600; margin-bottom: 4px;">Métrica todavía no disponible</div>
        <div style="font-size: 11px; color: var(--muted);">El dato del día aún no cargó. Volvé a recargar más tarde para verla actualizada.</div>
      </div>
    </div>
    <div class="kpi-card" id="kpi-avg-delivery-time">
      <div class="kpi-label">AVG Delivery Time</div>
      <div class="kpi-value">--</div>
      <div class="kpi-unavailable" style="display: none;">cargando...</div>
    </div>
    <div class="kpi-card" id="kpi-rejected-orders">
      <div class="kpi-label">Rejected Orders %</div>
      <div class="kpi-value">--</div>
      <div class="kpi-unavailable" style="display: none;">
        <div style="font-weight: 600; margin-bottom: 4px;">Métrica todavía no disponible</div>
        <div style="font-size: 11px; color: var(--muted);">El dato del día aún no cargó. Volvé a recargar más tarde para verla actualizada.</div>
      </div>
    </div>
    <div class="kpi-card" id="kpi-hc-sessions-orders">
      <div class="kpi-label">HC Sessions orders %</div>
      <div class="kpi-value">--</div>
      <div class="kpi-unavailable" style="display: none;">
        <div style="font-weight: 600; margin-bottom: 4px;">Métrica todavía no disponible</div>
        <div style="font-size: 11px; color: var(--muted);">El dato del día aún no cargó. Volvé a recargar más tarde para verla actualizada.</div>
      </div>
    </div>
  </div>
  <div class="main-full">
    <div class="view-toggle">
      <button class="view-btn active" id="btn-view-benchmark" onclick="switchMarketView('benchmark')">Benchmark entre tiendas</button>
      <button class="view-btn" id="btn-view-evolution" onclick="switchMarketView('evolution')">Evolución mensual</button>
      <div class="col-picker-wrap">
        <button class="col-picker-btn" onclick="toggleColPicker(event)">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/></svg>
          Elegir métricas (<span id="col-picker-count">0</span>)
        </button>
        <div class="col-picker-panel" id="col-picker-panel" style="display:none"></div>
      </div>
    </div>
    
    <!-- Mapa secundario colapsable para benchmark -->
    <div class="map-card" id="market-map-container" style="display:none; height:350px; margin-bottom:16px;">
      <div class="card-header">Mapa de Tiendas (Mes actual)</div>
      <div id="market-map" class="map-container" style="min-height:0;"></div>
    </div>

    <div class="table-card">
      <div class="table-wrap">
        <table id="market-table">
          <thead id="market-table-head"></thead>
          <tbody id="market-table-body">
            <tr><td><div class="empty-state">Cargando...</div></td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
// ============================================================
// GLOBAL STATE & UTILS
// ============================================================
let activeTab = 'rings';
let gMapRings, gMapCity, gMapMarket;
let gPolygon, gRings = [], gMarker;
let gCityMarkers = [], gCityHeatmap;
let gMarketMarkers = [], gMarketPolygons = [];
let ringsData = [], cityData = [], marketData = [];
let cityGrid = [];
let currentMetricRings = 'covered_maus';
let barChartRings;
let marketView = 'benchmark';
let marketSortCol = 'penetration_pct', marketSortAsc = false;
let citySortCol = 'users', citySortAsc = false;

