# Fuente
font-family = "JetBrainsMono Nerd Font"
font-size = 15
adjust-cell-height = 30%

# Tema: Tokyo Night
background = 1a1b26
foreground = c0caf5

# Transparencia (0.0 = invisible, 1.0 = opaco)
background-opacity = 0.85
background-blur = 10

# Padding
window-padding-x = 10
window-padding-y = 10

# Paleta de colores
palette = 0=#15161e
palette = 1=#f7768e
palette = 2=#9ece6a
palette = 3=#e0af68
palette = 4=#7aa2f7
palette = 5=#bb9af7
palette = 6=#7dcfff
palette = 7=#a9b1d6
palette = 8=#4a4868
palette = 9=#f7768e
palette = 10=#9ece6a
palette = 11=#e0af68
palette = 12=#7aa2f7
palette = 13=#bb9af7
palette = 14=#7dcfff
palette = 15=#c0caf5

# Sin sombra de ventana (mejor con transparencia)
macos-window-shadow = false

# Ventana maximizada al iniciar
window-width = 9999
window-height = 9999

# Custom icon
macos-icon = glass

# Titlebar
macos-titlebar-style = transparent

# System
confirm-close-surface = false
command = /opt/homebrew/bin/fish

# Prevenir cierre accidental con Cmd+Q
keybind = cmd+q=ignore
keybind = cmd+shift+q=quit

# Prevenir cierre accidental con Cmd+Z
keybind = cmd+z=ignore

# Tabs
keybind = cmd+t=new_tab
keybind = cmd+shift+left=previous_tab
keybind = cmd+shift+right=next_tab
keybind = cmd+w=close_surface
keybind = cmd+shift+w=ignore
keybind = ctrl+shift+w=ignore

# Splits
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:top
keybind = cmd+alt+down=goto_split:bottom
keybind = cmd+shift+e=equalize_splits
keybind = cmd+shift+f=toggle_split_zoom

# Font size
keybind = cmd+plus=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+zero=reset_font_size

# Quick terminal (global hotkey)
keybind = global:ctrl+grave_accent=toggle_quick_terminal

# Reload config
keybind = cmd+shift+comma=reload_config
