/**
 * Evalua los permisos de Drive para determinar si el archivo esta restringido, abierto a la organizacion o publico
 * Logica probada de Auditoria de Accesos con soporte para Drive API y DriveApp nativo
 */
function verificarEstadoSeguridad(fileId, cacheSeguridad) {
  if (cacheSeguridad && cacheSeguridad[fileId]) {
    return cacheSeguridad[fileId];
  }

  let estado = "";

  // 1. Intento prioritario con Advanced Drive Service (Drive API v2)
  try {
    if (typeof Drive !== 'undefined' && Drive.Permissions && Drive.Permissions.list) {
      const permisos = Drive.Permissions.list(fileId, { supportsAllDrives: true });
      const items = (permisos && permisos.items) ? permisos.items : [];

      if (items.some(p => p.type === 'anyone')) {
        estado = 'Abierto (Publico en Internet)';
      } else if (items.some(p => p.type === 'domain')) {
        estado = 'Abierto (Organizacion con enlace)';
      } else {
        const cantPersonas = items.filter(p => p.type === 'user' || p.type === 'group').length;
        estado = cantPersonas > 0 ? `Restringido (${cantPersonas} con acceso)` : 'Restringido (Privado)';
      }
    }
  } catch (errApi) {
    // Fallback silencioso a DriveApp
  }

  // 2. Fallback nativo con DriveApp
  if (!estado) {
    try {
      const file = DriveApp.getFileById(fileId);
      const access = file.getSharingAccess();

      if (access === DriveApp.Access.ANYONE || access === DriveApp.Access.ANYONE_WITH_LINK) {
        estado = 'Abierto (Publico en Internet)';
      } else if (access === DriveApp.Access.DOMAIN || access === DriveApp.Access.DOMAIN_WITH_LINK) {
        estado = 'Abierto (Organizacion con enlace)';
      } else {
        estado = 'Restringido';
      }
    } catch (e) {
      estado = 'Sin acceso';
    }
  }

  if (cacheSeguridad) cacheSeguridad[fileId] = estado;
  return estado;
}

/**
 * Evalua los permisos de acceso del Dataset y Tabla de BigQuery
 * Detalla si es publico, de organizacion, o restringido especificando grupos, usuarios y cuentas de servicio
 */
function verificarSeguridadBigQuery(projectId, datasetId, tableType, cacheSeguridadBQ) {
  const cacheKey = `${projectId}.${datasetId}`;
  if (cacheSeguridadBQ && cacheSeguridadBQ[cacheKey]) {
    let base = cacheSeguridadBQ[cacheKey];
    if (tableType === "VIEW" && !base.includes("Vista")) return base + " - Vista";
    if (tableType === "MATERIALIZED_VIEW" && !base.includes("Vista")) return base + " - Vista Materializada";
    if (tableType === "EXTERNAL" && !base.includes("Externa")) return base + " - Tabla Externa";
    return base;
  }

  let estado = "Restringido";

  try {
    if (typeof BigQuery !== 'undefined' && BigQuery.Datasets && BigQuery.Datasets.get) {
      const dataset = BigQuery.Datasets.get(projectId, datasetId);
      const accessEntries = (dataset && dataset.access) ? dataset.access : [];

      let esPublico = false;
      let esOrganizacion = false;
      let dominios = [];
      let cantGrupos = 0;
      let cantUsuarios = 0;
      let cantServiceAccounts = 0;
      let tieneProjectRoles = false;

      accessEntries.forEach(a => {
        if (a.specialGroup === 'allUsers' || a.iamMember === 'allUsers') {
          esPublico = true;
        }
        if (a.specialGroup === 'allAuthenticatedUsers' || a.iamMember === 'allAuthenticatedUsers') {
          esOrganizacion = true;
        }
        if (a.domain) {
          esOrganizacion = true;
          dominios.push(a.domain);
        }
        if (a.groupByEmail) {
          cantGrupos++;
        }
        if (a.userByEmail) {
          cantUsuarios++;
        }
        if (a.specialGroup && a.specialGroup.startsWith("project")) {
          tieneProjectRoles = true;
        }
        if (a.iamMember) {
          if (a.iamMember.startsWith("group:")) cantGrupos++;
          else if (a.iamMember.startsWith("user:")) cantUsuarios++;
          else if (a.iamMember.startsWith("serviceAccount:")) cantServiceAccounts++;
        }
      });

      if (esPublico) {
        estado = "Abierto (Publico en Internet)";
      } else if (esOrganizacion) {
        const domStr = dominios.length > 0 ? ` (${dominios.join(", ")})` : "";
        estado = `Abierto - Organizacion${domStr}`;
      } else {
        const componentes = [];
        if (cantGrupos > 0) componentes.push(`${cantGrupos} grupo${cantGrupos > 1 ? 's' : ''}`);
        if (cantUsuarios > 0) componentes.push(`${cantUsuarios} usuario${cantUsuarios > 1 ? 's' : ''}`);
        if (cantServiceAccounts > 0) componentes.push(`${cantServiceAccounts} SA`);

        if (componentes.length > 0) {
          estado = `Restringido (${componentes.join(", ")})`;
        } else if (tieneProjectRoles) {
          estado = "Restringido (Solo Roles del Proyecto)";
        } else {
          estado = "Restringido (Privado)";
        }
      }
    } else {
      estado = "Restringido";
    }
  } catch (e) {
    if (e.message && (e.message.includes("Access Denied") || e.message.includes("403"))) {
      estado = "Restringido (Sin permiso IAM en Dataset)";
    } else {
      estado = "Restringido";
    }
  }

  if (cacheSeguridadBQ) cacheSeguridadBQ[cacheKey] = estado;

  if (tableType === "VIEW" && !estado.includes("Vista")) {
    estado += " - Vista";
  } else if (tableType === "MATERIALIZED_VIEW" && !estado.includes("Vista")) {
    estado += " - Vista Materializada";
  } else if (tableType === "EXTERNAL" && !estado.includes("Externa")) {
    estado += " - Tabla Externa";
  }

  return estado;
}

/**
 * Extrae ID limpio si se pego un link completo
 */
function extraerId(urlOrId){
  let id = String(urlOrId || "").trim();
  if (id.includes("spreadsheets/d/")) {
    id = id.split("spreadsheets/d/")[1].split("/")[0];
  }
  id = id.split("/")[0].split("?")[0].split("#")[0];
  return id.trim();
}

/**
 * Obtiene fecha de ultima actualizacion de BigQuery para Tablas en Sheets
 */
function obtenerFechaBQ(fileId, extractName, cacheSS) {
  try {
    let targetSs;
    if (cacheSS && cacheSS[fileId]) {
      targetSs = cacheSS[fileId];
    } else {
      targetSs = SpreadsheetApp.openById(fileId);
      if (cacheSS) cacheSS[fileId] = targetSs;
    }

    const cleanTab = String(extractName || "").trim();
    let sheet = targetSs.getSheetByName(cleanTab);

    if (!sheet) {
      const allSheets = targetSs.getSheets();
      sheet = allSheets.find(s => s.getName().trim().toLowerCase() === cleanTab.toLowerCase());
    }

    if (!sheet) return "Pestana no existe";

    let esTablaConexion = false;
    let fechaMasReciente = null;

    // Tablas BigQuery
    try {
      const tables = sheet.getDataSourceTables();
      if (tables && tables.length > 0) {
        esTablaConexion = true;
        for (let t of tables) {
          const status = t.getStatus();
          if (status) {
            const date = status.getLastRefreshedTime();
            if (date instanceof Date && (!fechaMasReciente || date > fechaMasReciente)) {
              fechaMasReciente = date;
            }
          }
        }
      }
    } catch(err) {
      Logger.log("Error leyendo tables en " + fileId + ": " + err.message);
    }

    // Pivot Tables BigQuery
    try {
      const pivots = sheet.getDataSourcePivotTables();
      if (pivots && pivots.length > 0) {
        esTablaConexion = true;
        for (let p of pivots) {
          const status = p.getStatus();
          if (status) {
            const date = status.getLastRefreshedTime();
            if (date instanceof Date && (!fechaMasReciente || date > fechaMasReciente)) {
              fechaMasReciente = date;
            }
          }
        }
      }
    } catch(err) {
      Logger.log("Error leyendo pivots en " + fileId + ": " + err.message);
    }

    if (fechaMasReciente) {
      return fechaMasReciente;
    }

    if (esTablaConexion) {
      return "Nunca refrescado";
    }

    return "No es tabla BigQuery";

  } catch(e) {
    return "Error acceso: " + e.message;
  }
}

/**
 * Marca ultima ejecucion en celda A5 (Tablas)
 */
function marcarUltimaEjecucion(sheet, prefijo) {
  const fechaActual = new Date();
  const fechaFormateada = Utilities.formatDate(
    fechaActual,
    Session.getScriptTimeZone(),
    "dd/MM/yyyy HH:mm:ss"
  );
  sheet.getRange("A5").setValue(prefijo + fechaFormateada);
}

/**
 * Marca ultima ejecucion en celda A5 (Querys)
 */
function QuerysMarcarUltimaEjecucion(sheet, prefijo) {
  const ahora = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), "dd/MM/yyyy HH:mm:ss");
  sheet.getRange("A5").setValue(prefijo + ahora);
}
