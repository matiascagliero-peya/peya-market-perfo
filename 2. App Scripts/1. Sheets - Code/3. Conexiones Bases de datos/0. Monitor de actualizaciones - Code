/**
 * Funcion interna para auditar solo Col N en Tablas
 */
function auditarSeguridadTablasSheets(sheet) {
  const infoEncabezado = detectarEncabezados(sheet, 'tablas');
  const headerRow = infoEncabezado.headerRow;
  const startRow = headerRow + 1;

  const maxRowsInSheet = sheet.getMaxRows();
  if (maxRowsInSheet < startRow) return 0;

  const colFileIdIdx = infoEncabezado.colFileId;
  const colSeguridadIdx = infoEncabezado.colSeguridad;

  const totalRangeRows = maxRowsInSheet - startRow + 1;
  const valuesB = sheet.getRange(startRow, 2, totalRangeRows, 1).getValues();
  const valuesF = sheet.getRange(startRow, colFileIdIdx, totalRangeRows, 1).getValues();

  let lastRowConDatos = startRow;
  for (let r = valuesF.length - 1; r >= 0; r--) {
    const valF = String(valuesF[r][0] || "").trim();
    const valB = String(valuesB[r][0] || "").trim();
    if ((valF && valF !== "" && valF !== "." && valF !== "--" && !valF.startsWith("=")) ||
        (valB && valB !== "" && valB !== "." && valB !== "--" && !valB.startsWith("="))) {
      lastRowConDatos = startRow + r;
      break;
    }
  }

  if (lastRowConDatos < startRow) return 0;

  const numRows = lastRowConDatos - startRow + 1;
  const dataF = sheet.getRange(startRow, colFileIdIdx, numRows, 1).getValues();

  const nuevosEstadosSeguridad = [];
  const cacheSeguridad = {};
  let totalArchivos = 0;

  for (let i = 0; i < numRows; i++) {
    const rawFileId = String(dataF[i][0] || "").trim();

    if (!rawFileId || rawFileId === "" || rawFileId === "." || rawFileId === "-" || rawFileId === "--" || rawFileId.startsWith("=")) {
      nuevosEstadosSeguridad.push([""]);
      continue;
    }

    const cleanId = extraerId(rawFileId);
    if (!cleanId || cleanId.length < 15) {
      nuevosEstadosSeguridad.push([""]);
      continue;
    }

    const valSeguridad = verificarEstadoSeguridad(cleanId, cacheSeguridad);
    nuevosEstadosSeguridad.push([valSeguridad]);
    totalArchivos++;
  }

  sheet.getRange(startRow, colSeguridadIdx, numRows, 1).setValues(nuevosEstadosSeguridad);
  return totalArchivos;
}

/**
 * Funcion interna para auditar solo Col K en Querys
 */
function auditarSeguridadQuerys(sheet) {
  const infoEncabezado = detectarEncabezados(sheet, 'querys');
  const headerRow = infoEncabezado.headerRow;
  const startRow = headerRow + 1;

  const maxRowsInSheet = sheet.getMaxRows();
  if (maxRowsInSheet < startRow) return 0;

  const colTableIdIdx = infoEncabezado.colTableId;
  const colSeguridadIdx = infoEncabezado.colSeguridad;
  const colNombreRefIdx = infoEncabezado.colNombreRef;

  const totalRangeRows = maxRowsInSheet - startRow + 1;
  const valuesB = sheet.getRange(startRow, colNombreRefIdx, totalRangeRows, 1).getValues();
  const valuesH = sheet.getRange(startRow, colTableIdIdx, totalRangeRows, 1).getValues();
  const valuesA = sheet.getRange(startRow, 1, totalRangeRows, 1).getValues();

  let lastRowConDatos = startRow;
  for (let r = totalRangeRows - 1; r >= 0; r--) {
    const valH = String(valuesH[r][0] || "").trim();
    const valB = String(valuesB[r][0] || "").trim();
    const valA = String(valuesA[r][0] || "").trim();
    if ((valH && valH !== "" && valH !== "." && valH !== "--" && !valH.startsWith("=")) ||
        (valB && valB !== "" && valB !== "." && valB !== "--" && !valB.startsWith("=")) ||
        (valA && valA !== "" && valA !== "." && valA !== "--" && !valA.startsWith("="))) {
      lastRowConDatos = startRow + r;
      break;
    }
  }

  if (lastRowConDatos < startRow) return 0;

  const numRows = lastRowConDatos - startRow + 1;
  const dataH = sheet.getRange(startRow, colTableIdIdx, numRows, 1).getValues();

  const nuevosEstadosSeguridad = [];
  const cacheSeguridadBQ = {};
  const cacheSeguridadDrive = {};
  let totalAuditados = 0;

  for (let i = 0; i < numRows; i++) {
    const rawTableId = String(dataH[i][0] || "").trim();

    if (!rawTableId || rawTableId === "" || rawTableId === "." || rawTableId === "-" || rawTableId === "--" || rawTableId.startsWith("=")) {
      nuevosEstadosSeguridad.push([""]);
      continue;
    }

    const cleanTableId = rawTableId.replace(/[`"'']/g, "").trim();
    const parts = cleanTableId.split('.');
    if (parts.length === 3 && parts[0].trim() !== "" && parts[1].trim() !== "" && parts[2].trim() !== "") {
      let tableType = "";
      try {
        if (typeof BigQuery !== 'undefined' && BigQuery.Tables && BigQuery.Tables.get) {
          const t = BigQuery.Tables.get(parts[0].trim(), parts[1].trim(), parts[2].trim());
          tableType = t.type || "";
        }
      } catch(errT) {}

      const valSeguridad = verificarSeguridadBigQuery(parts[0].trim(), parts[1].trim(), tableType, cacheSeguridadBQ);
      nuevosEstadosSeguridad.push([valSeguridad]);
      totalAuditados++;
    } else if (cleanTableId.includes("spreadsheets/d/") || cleanTableId.length >= 25) {
      const cleanId = extraerId(cleanTableId);
      const valSeguridad = verificarEstadoSeguridad(cleanId, cacheSeguridadDrive);
      nuevosEstadosSeguridad.push([valSeguridad]);
      totalAuditados++;
    } else {
      nuevosEstadosSeguridad.push([""]);
    }
  }

  sheet.getRange(startRow, colSeguridadIdx, numRows, 1).setValues(nuevosEstadosSeguridad);
  return totalAuditados;
}


// ====================================================================================
// PROCESO 4: FORZAR REFRESCO DE TABLAS ATRASADAS
// ====================================================================================
function refrescarTablasAtrasadas() {
  try {
    SpreadsheetApp.enableBigQueryExecution();
  } catch (e) {
    Logger.log("Aviso BigQueryExecution: " + e.message);
  }

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName("1. Tablas en Sheets") || ss.getActiveSheet();
  const infoEncabezado = detectarEncabezados(sheet, 'tablas');
  const startRow = infoEncabezado.headerRow + 1;
  const lastRow = sheet.getLastRow();

  if (lastRow < startRow) return;

  const numRows = lastRow - startRow + 1;
  const data = sheet.getRange(startRow, 1, numRows, Math.max(infoEncabezado.colExtract, 8)).getValues();

  const cacheSS = {};
  let totalRefrescadas = 0;

  for (let i = 0; i < data.length; i++) {
    const estado    = String(data[i][4] || ""); // Col E
    const rawFileId = String(data[i][infoEncabezado.colFileId - 1] || "");
    const tabName   = String(data[i][infoEncabezado.colExtract - 1] || "");

    if (!estado || !rawFileId || !tabName) continue;
    if (!estado.toLowerCase().includes("atras")) continue;

    const fileId = extraerId(rawFileId.trim());
    const cleanTabName = tabName.trim();

    try {
      let targetSs = cacheSS[fileId];
      if (!targetSs) {
        targetSs = SpreadsheetApp.openById(fileId);
        cacheSS[fileId] = targetSs;
      }

      let sheetTarget = targetSs.getSheetByName(cleanTabName);
      if (!sheetTarget) {
        sheetTarget = targetSs.getSheets().find(s => s.getName().trim().toLowerCase() === cleanTabName.toLowerCase());
      }
      if (!sheetTarget) continue;

      const tables = sheetTarget.getDataSourceTables();
      for (let t of tables) {
        t.refreshData();
      }

      const pivots = sheetTarget.getDataSourcePivotTables();
      for (let p of pivots) {
        p.refreshData();
      }

      totalRefrescadas++;
      Logger.log("Refresco solicitado para: " + fileId + " [" + cleanTabName + "]");
    } catch(e) {
      Logger.log("Error en archivo " + fileId + ": " + e.message);
    }
  }

  ss.toast(`Refresco enviado a ${totalRefrescadas} tablas atrasadas`, "Refresco BigQuery");
}

