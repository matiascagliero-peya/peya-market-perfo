// ====================================================================================
// PROCESO 3: ACTUALIZAR SOLO ESTADOS DE SEGURIDAD (Col N en Tablas y Col K en Querys)
// ====================================================================================
function verificarSeguridad() {
  const tiempoInicio = new Date().getTime();
  const ss = SpreadsheetApp.getActiveSpreadsheet();

  let sheetTablas = ss.getSheetByName("1. Tablas en Sheets") || ss.getSheetByName("1. Sheets");
  let sheetQuerys = obtenerHojaQuerys(ss);

  let totalTablas = 0;
  let totalQuerys = 0;

  // Actualizar Col N en Tablas
  if (sheetTablas) {
    totalTablas = auditarSeguridadTablasSheets(sheetTablas);
  }

  // Actualizar Col K en Querys
  if (sheetQuerys) {
    totalQuerys = auditarSeguridadQuerys(sheetQuerys);
  }

  const duracion = ((new Date().getTime() - tiempoInicio) / 1000).toFixed(1);
  const msg = `Seguridad actualizada en ${duracion}s. Tablas (Col N): ${totalTablas} | Querys (Col K): ${totalQuerys}`;
  console.log(msg);
  ss.toast(msg, "Seguridad");
}

