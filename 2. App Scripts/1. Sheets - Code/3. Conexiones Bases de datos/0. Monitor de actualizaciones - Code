// ====================================================================================
// PROCESO 2: QUERYS EN BIGQUERY (Verifica Table Id -> Fechas Col D + Seguridad Col K)
// ====================================================================================
function verificarFechaQuerys(targetSheet) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = (targetSheet && typeof targetSheet.getRange === 'function') ? targetSheet : obtenerHojaQuerys(ss);

  if (!sheet) {
    console.warn("Pestana de Querys no encontrada");
    return 0;
  }

  // Deteccion inteligente de la fila de encabezados y columnas
  const infoEncabezado = detectarEncabezados(sheet, 'querys');
  const headerRow = infoEncabezado.headerRow; // Tipicamente Fila 5
  const startRow = headerRow + 1;             // Tipicamente Fila 6 (donde inician secciones o datos)

  const maxRowsInSheet = sheet.getMaxRows();
  if (maxRowsInSheet < startRow) return 0;

  // Asignacion estricta de columnas detectadas
  const colFechaIdx     = infoEncabezado.colFecha;     // Debe ser Col D (4) - "Ültima actualización"
  const colTableIdIdx   = infoEncabezado.colTableId;   // Debe ser Col H (8) - "Table Id"
  const colSeguridadIdx = infoEncabezado.colSeguridad; // Debe ser Col K (11) - "Estado de Seguridad"
  const colNombreRefIdx = infoEncabezado.colNombreRef; // Debe ser Col B (2) - "Nombre de referencia"

  console.log(`Pestana Querys: '${sheet.getName()}' | Encabezado Fila: ${headerRow} | Col Fecha: ${colFechaIdx} | Col TableId: ${colTableIdIdx} | Col Seguridad: ${colSeguridadIdx}`);

  const totalRangeRows = maxRowsInSheet - startRow + 1;
  const valuesB = sheet.getRange(startRow, colNombreRefIdx, totalRangeRows, 1).getValues();
  const valuesTableId = sheet.getRange(startRow, colTableIdIdx, totalRangeRows, 1).getValues();
  const valuesA = sheet.getRange(startRow, 1, totalRangeRows, 1).getValues();

  // Busqueda de la ultima fila real con datos o titulos
  let lastRowConDatos = startRow;
  for (let r = totalRangeRows - 1; r >= 0; r--) {
    const valT = String(valuesTableId[r][0] || "").trim();
    const valB = String(valuesB[r][0] || "").trim();
    const valA = String(valuesA[r][0] || "").trim();
    if ((valT && valT !== "" && valT !== "." && valT !== "--" && !valT.startsWith("=")) ||
        (valB && valB !== "" && valB !== "." && valB !== "--" && !valB.startsWith("=")) ||
        (valA && valA !== "" && valA !== "." && valA !== "--" && !valA.startsWith("="))) {
      lastRowConDatos = startRow + r;
      break;
    }
  }

  if (lastRowConDatos < startRow) return 0;

  const numRows = lastRowConDatos - startRow + 1;

  // Lectura directa de la columna Table Id
  const dataTableId = sheet.getRange(startRow, colTableIdIdx, numRows, 1).getValues();

  const nuevosEstadosFechas = [];
  const nuevosEstadosSeguridad = [];

  const cacheSeguridadBQ = {};
  const cacheSeguridadDrive = {};
  let querysProcesadas = 0;

  const servicioDisponible = typeof BigQuery !== 'undefined' && BigQuery.Tables && BigQuery.Tables.get;

  for (let i = 0; i < numRows; i++) {
    const rawTableId = String(dataTableId[i][0] || "").trim();

    // REGLA ESTRICTA: Si en Table Id no hay nada, es invalido, es un titulo de seccion o fila vacia:
    // NO PONER FECHA EN COL D ("") Y NO PONER SEGURIDAD EN COL K ("").
    if (!rawTableId || rawTableId === "" || rawTableId === "." || rawTableId === "-" || rawTableId === "--" || rawTableId.startsWith("=")) {
      nuevosEstadosFechas.push([""]);
      nuevosEstadosSeguridad.push([""]);
      continue;
    }

    // Limpieza de comillas y backticks accidentales
    const cleanTableId = rawTableId.replace(/[`"'']/g, "").trim();

    // Verificamos si es un Table ID valido de BigQuery (project.dataset.table -> 3 partes)
    const parts = cleanTableId.split('.');
    if (parts.length === 3 && parts[0].trim() !== "" && parts[1].trim() !== "" && parts[2].trim() !== "") {
      if (!servicioDisponible) {
        nuevosEstadosFechas.push(["Activar servicio BigQuery"]);
        nuevosEstadosSeguridad.push([""]);
        continue;
      }

      const proj = parts[0].trim();
      const ds = parts[1].trim();
      const tbl = parts[2].trim();

      try {
        // 1. Obtener fecha de ultima modificacion y tipo de tabla en BigQuery
        const table = BigQuery.Tables.get(proj, ds, tbl);
        const timestamp = parseInt(table.lastModifiedTime, 10);
        if (!isNaN(timestamp) && timestamp > 0) {
          const fechaFinal = new Date(timestamp);
          const fechaFormateada = Utilities.formatDate(fechaFinal, Session.getScriptTimeZone(), "dd/MM/yyyy HH:mm:ss");
          nuevosEstadosFechas.push([fechaFormateada]);
        } else {
          nuevosEstadosFechas.push(["Sin fecha"]);
        }

        // 2. Obtener estado de seguridad enriquecido del Dataset / Tabla y colocarlo en Col K
        const valSeguridad = verificarSeguridadBigQuery(proj, ds, table.type || "", cacheSeguridadBQ);
        nuevosEstadosSeguridad.push([valSeguridad]);

        querysProcesadas++;
      } catch (e) {
        const errorMsg = String(e.message || "");
        if (errorMsg.includes("Not found") || errorMsg.includes("404")) {
          nuevosEstadosFechas.push(["Tabla no encontrada"]);
          nuevosEstadosSeguridad.push(["Tabla no encontrada"]);
        } else if (errorMsg.includes("Access Denied") || errorMsg.includes("403")) {
          nuevosEstadosFechas.push(["Sin acceso"]);
          nuevosEstadosSeguridad.push(["Sin acceso"]);
        } else {
          nuevosEstadosFechas.push(["Sin acceso"]);
          nuevosEstadosSeguridad.push(["Sin acceso"]);
        }
      }
    } else if (cleanTableId.includes("spreadsheets/d/") || cleanTableId.length >= 25) {
      // Si contiene un ID o link de Google Drive
      const cleanId = extraerId(cleanTableId);
      const valSeguridad = verificarEstadoSeguridad(cleanId, cacheSeguridadDrive);
      nuevosEstadosFechas.push([""]);
      nuevosEstadosSeguridad.push([valSeguridad]);
    } else {
      // Si no es un Table ID valido de BigQuery ni enlace de Drive, NO poner fecha
      nuevosEstadosFechas.push([""]);
      nuevosEstadosSeguridad.push([""]);
    }
  }

  // Escritura masiva en batch:
  // Columna D (colFechaIdx): Ultima actualizacion
  sheet.getRange(startRow, colFechaIdx, numRows, 1).setValues(nuevosEstadosFechas);

  // Columna K (colSeguridadIdx): Estado de Seguridad
  sheet.getRange(startRow, colSeguridadIdx, numRows, 1).setValues(nuevosEstadosSeguridad);

  // Ajuste de filas excedentes de manera segura
  try {
    const maxRows = sheet.getMaxRows();
    if (maxRows > lastRowConDatos + 10) {
      sheet.deleteRows(lastRowConDatos + 11, maxRows - (lastRowConDatos + 10));
    }
  } catch(e) {}

  QuerysMarcarUltimaEjecucion(sheet, "Ultima actualizacion: ");
  return querysProcesadas;
}

