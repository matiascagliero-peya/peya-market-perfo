/**
 * ====================================================================================
 * MONITOR DE ACTUALIZACIONES & AUDITORIA DE SEGURIDAD (BIGQUERY + SHEETS)
 * ====================================================================================
 *
 * CUAL FUNCION DEBERIAS CORRER?
 * ────────────────────────────────────────────────────────────────────────────────────
 *   SIEMPRE CORRE: verificarFecha()  [o verificarFechas()]
 *   (O desde el Menu: "Monitor de Actualizaciones" > "1. Verificar todo (Fechas y Seguridad)")
 *
 *   Esta funcion ejecuta todo de forma integral en un solo clic:
 *     1. Pestana "1. Tablas en Sheets":
 *        - Escribe la fecha de refresco de BigQuery en Columna D (Ültima actualización).
 *        - Escribe el Estado de Seguridad de Drive en Columna N (detallando personas/grupos).
 *        - Si una fila no tiene ID del archivo (Col F vacia, titulos o filas en blanco),
 *          deja Columnas D y N totalmente vacias ("") para no arrastrar fechas erroneas.
 *     2. Pestana "2. Querys":
 *        - Detecta dinamicamente los encabezados (Fila 5) y datos (desde Fila 6/7).
 *        - Distingue correctamente "Ültima actualización" (Col D) de "Forma de Actualización" (Col F).
 *        - Verifica la columna "Table Id" (Col H). Si no hay Table ID valido, NO pone fecha
 *          y deja Columnas D y K totalmente vacias ("").
 *        - Si el Table ID es valido, escribe la fecha en Col D y el Estado de Seguridad
 *          enriquecido en Col K (indicando grupos, usuarios, cuentas de servicio o tipo de vista).
 * ────────────────────────────────────────────────────────────────────────────────────
 */

/**
 * Menu sin emojis en la barra superior de Google Sheets
 */
function onOpen() {
  const ui = SpreadsheetApp.getUi();
  ui.createMenu('Monitor de Actualizaciones')
    .addItem('1. Verificar todo (Fechas y Seguridad)', 'verificarFecha')
    .addSeparator()
    .addItem('2. Verificar tablas en Sheets (Fechas Col D y Seguridad Col N)', 'verificarFechaTablasSheets')
    .addItem('3. Verificar Querys en BigQuery (Fechas Col D y Seguridad Col K)', 'verificarFechaQuerys')
    .addItem('4. Verificar solo estados de seguridad (Col N en Tablas y Col K en Querys)', 'verificarSeguridad')
    .addSeparator()
    .addItem('5. Forzar refresco de tablas atrasadas', 'refrescarTablasAtrasadas')
    .addToUi();
}

// ====================================================================================
// FUNCION PRINCIPAL: VERIFICAR FECHA Y SEGURIDAD EN AMBAS PESTANAS
// ====================================================================================
function verificarFecha() {
  const tiempoInicio = new Date().getTime();
  const ss = SpreadsheetApp.getActiveSpreadsheet();

  // 1. Sincronizar pestana de Tablas en Sheets (Col D: Fechas, Col N: Seguridad)
  let sheetTablas = ss.getSheetByName("1. Tablas en Sheets") || ss.getSheetByName("1. Sheets") || ss.getSheets()[0];
  let procesadasTablas = 0;
  if (sheetTablas && !sheetTablas.getName().toLowerCase().includes("query")) {
    console.log("Iniciando verificacion de Tablas en Sheets: " + sheetTablas.getName());
    procesadasTablas = verificarFechaTablasSheets(sheetTablas);
  }

  // 2. Sincronizar pestana de Querys en BigQuery (Col D: Fechas, Col K: Seguridad)
  let sheetQuerys = obtenerHojaQuerys(ss);
  let procesadasQuerys = 0;
  if (sheetQuerys) {
    console.log("Iniciando verificacion de Querys en BigQuery: " + sheetQuerys.getName());
    procesadasQuerys = verificarFechaQuerys(sheetQuerys);
  } else {
    console.warn("No se encontro pestana con nombre que contenga 'Query' o '2. Querys'");
  }

  const duracionSegundos = ((new Date().getTime() - tiempoInicio) / 1000).toFixed(1);
  const mensajeFinal = `Proceso completado en ${duracionSegundos}s. Tablas: ${procesadasTablas} | Querys: ${procesadasQuerys}`;
  console.log(mensajeFinal);
  ss.toast(mensajeFinal, "Verificacion Finalizada");
}

