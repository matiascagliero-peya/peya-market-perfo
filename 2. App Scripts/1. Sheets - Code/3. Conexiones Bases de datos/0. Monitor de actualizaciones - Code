/**
 * Busca de forma tolerante la hoja de Querys en el spreadsheet
 */
function obtenerHojaQuerys(ss) {
  const nombresPosibles = ["2. Querys", "Querys", "Query", "Panel de Actualizaciones - Querys", "2. Querys en BigQuery"];
  for (const n of nombresPosibles) {
    const s = ss.getSheetByName(n);
    if (s) return s;
  }
  const sheets = ss.getSheets();
  for (const s of sheets) {
    const name = s.getName().trim().toLowerCase();
    if (name.includes("query")) return s;
  }
  return null;
}

/**
 * Detecta dinamicamente en que fila estan los encabezados y los indices exactos de cada columna
 * Resuelve el problema donde la pagina de Querys tiene encabezados en Fila 5 (o Fila 7 en otras plantillas)
 * y evita que 'Forma de Actualización' sobreescriba 'Ültima actualización'.
 */
function detectarEncabezados(sheet, tipo) {
  const maxSearchRows = Math.min(sheet.getMaxRows(), 10);
  const totalCols = Math.min(sheet.getLastColumn() || 20, 26);

  let headerRow = tipo === 'querys' ? 5 : 7; // Valores por defecto
  let headerValues = [];

  // 1. Escaneo de filas 1 a 10 para ubicar la fila real de encabezados
  for (let r = 1; r <= maxSearchRows; r++) {
    const rowVals = sheet.getRange(r, 1, 1, totalCols).getValues()[0];
    const rowText = rowVals.map(v => String(v || "").toLowerCase().trim());

    if (tipo === 'querys') {
      const tieneTableId = rowText.some(t => t.includes("table id") || t.includes("table_id") || t.includes("tableid"));
      const tieneNombreRef = rowText.some(t => t.includes("nombre de referencia") || t.includes("referencia"));
      const tieneUsadoEn = rowText.some(t => t.includes("usado en"));
      if (tieneTableId || (tieneNombreRef && tieneUsadoEn)) {
        headerRow = r;
        headerValues = rowVals;
        break;
      }
    } else {
      const tieneFileId = rowText.some(t => t.includes("id del archivo") || t.includes("file id") || t.includes("id archivo"));
      const tieneExtracto = rowText.some(t => t.includes("extracto") || t.includes("extract"));
      if (tieneFileId || tieneExtracto) {
        headerRow = r;
        headerValues = rowVals;
        break;
      }
    }
  }

  // Si no se encontro fila por coincidencia exacta, se lee la fila default
  if (!headerValues || headerValues.length === 0) {
    headerValues = sheet.getRange(headerRow, 1, 1, totalCols).getValues()[0];
  }

  // Indices por defecto segun el tipo de hoja
  let colFecha     = 4;                      // Default Col D (4)
  let colFileId    = 6;                      // Default Col F (6) [solo Tablas]
  let colExtract   = 7;                      // Default Col G (7) [solo Tablas]
  let colTableId   = 8;                      // Default Col H (8) [solo Querys]
  let colSeguridad = tipo === 'querys' ? 11 : 14; // Col K (11) en Querys, Col N (14) en Tablas
  let colNombreRef = 2;                      // Default Col B (2)

  // 2. Mapeo preciso de columnas examinando el encabezado encontrado
  for (let c = 0; c < headerValues.length; c++) {
    const h = String(headerValues[c] || "").trim().toLowerCase();
    if (!h) continue;

    // FECHA DE ACTUALIZACIÓN:
    // Debe coincidir con 'actualiz' o 'fecha', pero EXCLUIR estrictamente 'forma' y 'frecuencia'
    // para evitar que 'Forma de Actualización' (Col F) sobreescriba 'Ültima actualización' (Col D)
    if ((h.includes("actualiz") || h.includes("fecha")) && !h.includes("forma") && !h.includes("frecuencia")) {
      colFecha = c + 1;
    }
    else if (h.includes("table id") || h.includes("table_id") || h.includes("table path") || h.includes("tableid")) {
      colTableId = c + 1;
    }
    else if (h.includes("id del archivo") || h.includes("file id") || h.includes("id archivo")) {
      colFileId = c + 1;
    }
    else if (h.includes("extracto") || h.includes("extract") || h.includes("pestaña") || h.includes("hoja")) {
      colExtract = c + 1;
    }
    else if (h.includes("seguridad") || h.includes("security")) {
      colSeguridad = c + 1;
    }
    else if (h.includes("nombre") || h.includes("referencia")) {
      colNombreRef = c + 1;
    }
  }

  return {
    headerRow: headerRow,
    colFecha: colFecha,
    colTableId: colTableId,
    colFileId: colFileId,
    colExtract: colExtract,
    colSeguridad: colSeguridad,
    colNombreRef: colNombreRef
  };
}


