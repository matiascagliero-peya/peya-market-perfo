// CONFIGURACIÓN
const ID_MASTER_TEMPLATE = "1H_gDXL9IQ9HCHSAzzDT8oGBNwPIw4rHmbjtqcqKJikc"; 
const NOMBRE_HOJA_TEMPLATE = "1 Template";
const CELDA_NOMBRE_PAIS = "C6";
const CELDA_LINK_PPT = "AP14"; // <--- AQUÍ VA EL LINK AHORA

// --- FUNCIÓN MAESTRA (WORKER) ---
function _workerTemplate(pais) {
  if (!pais) { Logger.log("❌ Error: País no definido."); return; }

  try {
    Logger.log(`🔵 [TAREA 2] Procesando: ${pais.country}...`);

    // 1. ABRIR MASTER
    const ssMaster = SpreadsheetApp.openById(ID_MASTER_TEMPLATE);
    const hojaOrigen = ssMaster.getSheetByName(NOMBRE_HOJA_TEMPLATE);
    if (!hojaOrigen) throw new Error("No existe '1 Template' en el Master.");

    // 2. ABRIR DESTINO
    const ssDestino = SpreadsheetApp.openById(pais.id);

    // 3. LIMPIEZA (Manejo de hoja vieja)
    const hojaVieja = ssDestino.getSheetByName(NOMBRE_HOJA_TEMPLATE);
    if (hojaVieja) {
      try {
        // Renombramos a BASURA antes de borrar
        hojaVieja.setName("BASURA_TEMP_" + new Date().getTime());
        ssDestino.deleteSheet(hojaVieja);
      } catch (e) {
        hojaVieja.hideSheet();
      }
    }

    // 4. COPIAR Y RENOMBRAR
    const nuevaHoja = hojaOrigen.copyTo(ssDestino);
    nuevaHoja.setName(NOMBRE_HOJA_TEMPLATE);

    // 5. PERSONALIZAR

    // A. Nombre del País en C6 y bloquearlo
    const celdaPais = nuevaHoja.getRange(CELDA_NOMBRE_PAIS);
    celdaPais.setValue(pais.country);

    // ---- INICIO DEL BLOQUEO DE PAÍS ----
    const proteccionPais = celdaPais.protect().setDescription('Bloqueo automático de celda de país');
    const editoresPais = proteccionPais.getEditors();
    proteccionPais.removeEditors(editoresPais);
    if (proteccionPais.canDomainEdit()) {
      proteccionPais.setDomainEdit(false);
    }
    // ---- FIN DEL BLOQUEO DE PAÍS ----


    // B. Link de la Presentación en AR14 y bloquearlo
    if (typeof PPTs_PAISES_DE_DESTINO !== 'undefined') {
      const ppt = PPTs_PAISES_DE_DESTINO.find(p => p.country === pais.country);
      if (ppt && ppt.id) {
        const urlPPT = "https://docs.google.com/presentation/d/" + ppt.id;
        const celdaPPT = nuevaHoja.getRange(CELDA_LINK_PPT);
        celdaPPT.setValue(urlPPT);
        
        // ---- INICIO DEL BLOQUEO DEL LINK PPT ----
        const proteccionPPT = celdaPPT.protect().setDescription('Bloqueo automático de link de PPT');
        const editoresPPT = proteccionPPT.getEditors();
        proteccionPPT.removeEditors(editoresPPT);
        if (proteccionPPT.canDomainEdit()) {
          proteccionPPT.setDomainEdit(false);
        }
        // ---- FIN DEL BLOQUEO DEL LINK PPT ----
        
        Logger.log("   > 🔗 Link pegado y bloqueado en " + CELDA_LINK_PPT);
      } else {
        Logger.log("   > ⚠️ No hay ID de PPT configurado para este país.");
      }
    }

    // 6. MOVER AL INICIO
    nuevaHoja.activate();
    try { ssDestino.moveActiveSheet(1); } catch(e) {}

    Logger.log(`   ✅ ${pais.country} OK. Celdas de País y PPT protegidas.`);

  } catch (e) {
    Logger.log(`   🔴 ERROR en ${pais.country}: ${e.message}`);
  }
}

