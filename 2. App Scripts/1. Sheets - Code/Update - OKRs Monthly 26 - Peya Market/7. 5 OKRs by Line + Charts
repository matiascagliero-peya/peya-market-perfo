const CONFIG_OKRS_CHARTS = {
  nombreHoja: "5 OKRs by Line + Charts"
};

function _okrsChartsWorker(targetCountry) {
  try {
    Logger.log(`--- [TAREA 5 OKRs CHARTS] Iniciando para ${targetCountry.country.toUpperCase()} ---`);
    
    // 1. Abrir origen
    const sourceSpreadsheet = SpreadsheetApp.openById(SOURCE_SPREADSHEET_ID);
    const sourceSheet = sourceSpreadsheet.getSheetByName(CONFIG_OKRS_CHARTS.nombreHoja);
    if (!sourceSheet) throw new Error(`La hoja de origen '${CONFIG_OKRS_CHARTS.nombreHoja}' no fue encontrada.`);
    
    // 2. Abrir destino
    const targetSpreadsheet = SpreadsheetApp.openById(targetCountry.id);
    const existingSheet = targetSpreadsheet.getSheetByName(CONFIG_OKRS_CHARTS.nombreHoja);
    
    let newSheet;

    // 3. Reemplazar o Copiar hoja (MANTENIENDO EL ORDEN)
    if (existingSheet) {
      const originalIndex = existingSheet.getIndex(); // Guarda la posición actual
      targetSpreadsheet.deleteSheet(existingSheet);
      newSheet = sourceSheet.copyTo(targetSpreadsheet);
      newSheet.setName(CONFIG_OKRS_CHARTS.nombreHoja);
      targetSpreadsheet.setActiveSheet(newSheet);
      targetSpreadsheet.moveActiveSheet(originalIndex); // Restaura la posición
    } else {
      newSheet = sourceSheet.copyTo(targetSpreadsheet);
      newSheet.setName(CONFIG_OKRS_CHARTS.nombreHoja);
    }

    Logger.log(`>>> [TAREA 5 OKRs CHARTS] Proceso completado para ${targetCountry.country.toUpperCase()}.`);
  } catch (error) {
    Logger.log(`ERROR en [TAREA 5 OKRs CHARTS] para ${targetCountry.country.toUpperCase()}: ${error.toString()}`);
  }
}

