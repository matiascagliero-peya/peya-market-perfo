const CONFIG_ANALISIS_UF = {
  nombreHoja: "10 Analisis UF",
  celdaPais: "C6"
};

function _analisisUFWorker(targetCountry) {
  try {
    Logger.log(`--- [TAREA 10 ANALISIS UF] Iniciando para ${targetCountry.country.toUpperCase()} ---`);
    
    // 1. Abrir origen
    const sourceSpreadsheet = SpreadsheetApp.openById(SOURCE_SPREADSHEET_ID);
    const sourceSheet = sourceSpreadsheet.getSheetByName(CONFIG_ANALISIS_UF.nombreHoja);
    if (!sourceSheet) throw new Error(`La hoja de origen '${CONFIG_ANALISIS_UF.nombreHoja}' no fue encontrada.`);
    
    // 2. Abrir destino
    const targetSpreadsheet = SpreadsheetApp.openById(targetCountry.id);
    const existingSheet = targetSpreadsheet.getSheetByName(CONFIG_ANALISIS_UF.nombreHoja);
    
    let newSheet;

    // 3. Reemplazar o Copiar hoja (MANTENIENDO EL ORDEN)
    if (existingSheet) {
      const originalIndex = existingSheet.getIndex(); // Guarda la posición actual
      targetSpreadsheet.deleteSheet(existingSheet);
      newSheet = sourceSheet.copyTo(targetSpreadsheet);
      newSheet.setName(CONFIG_ANALISIS_UF.nombreHoja);
      targetSpreadsheet.setActiveSheet(newSheet);
      targetSpreadsheet.moveActiveSheet(originalIndex); // Restaura la posición
    } else {
      newSheet = sourceSheet.copyTo(targetSpreadsheet);
      newSheet.setName(CONFIG_ANALISIS_UF.nombreHoja);
    }

    // 4. Escribir el País en la celda configurada y bloquearla
    const celdaPais = newSheet.getRange(CONFIG_ANALISIS_UF.celdaPais);
    celdaPais.setValue(targetCountry.country);

    // ---- INICIO DEL BLOQUEO ----
    // Creamos la protección para el rango (celda C4 según configuración)
    const proteccion = celdaPais.protect().setDescription('Bloqueo automático de celda de país');
    
    // Removemos a todos los editores para dejar únicamente al dueño/ejecutor del script
    const editores = proteccion.getEditors();
    proteccion.removeEditors(editores);
    
    // Restringimos la edición dentro de dominios de Google Workspace (si aplica)
    if (proteccion.canDomainEdit()) {
      proteccion.setDomainEdit(false);
    }
    // ---- FIN DEL BLOQUEO ----

    Logger.log(`>>> [TAREA 10 ANALISIS UF] Proceso completado y celda bloqueada para ${targetCountry.country.toUpperCase()}.`);
  } catch (error) {
    Logger.log(`ERROR en [TAREA 10 ANALISIS UF] para ${targetCountry.country.toUpperCase()}: ${error.toString()}`);
  }
}

