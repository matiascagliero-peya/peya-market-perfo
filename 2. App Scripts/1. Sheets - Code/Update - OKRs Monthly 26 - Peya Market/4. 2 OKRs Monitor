const CONFIG_OKRS_MONITOR = {
  nombreHoja: "2 OKRs Monitor",
  rangoPais: "F4",
  ocultarFila: null
};

function _okrsMonitorWorker(targetCountry) {
  try {
    Logger.log(`--- [TAREA 2 OKRs Monitor] Iniciando para ${targetCountry.country.toUpperCase()} ---`);
    const sourceSpreadsheet = SpreadsheetApp.openById(SOURCE_SPREADSHEET_ID);
    const sourceSheet = sourceSpreadsheet.getSheetByName(CONFIG_OKRS_MONITOR.nombreHoja);
    if (!sourceSheet) throw new Error(`La hoja de origen '${CONFIG_OKRS_MONITOR.nombreHoja}' no fue encontrada.`);
    const targetSpreadsheet = SpreadsheetApp.openById(targetCountry.id);
    const existingSheet = targetSpreadsheet.getSheetByName(CONFIG_OKRS_MONITOR.nombreHoja);
    let newSheet;
    if (existingSheet) {
      const originalIndex = existingSheet.getIndex();
      targetSpreadsheet.deleteSheet(existingSheet);
      newSheet = sourceSheet.copyTo(targetSpreadsheet);
      newSheet.setName(CONFIG_OKRS_MONITOR.nombreHoja);
      targetSpreadsheet.setActiveSheet(newSheet);
      targetSpreadsheet.moveActiveSheet(originalIndex);
    } else {
      newSheet = sourceSheet.copyTo(targetSpreadsheet);
      newSheet.setName(CONFIG_OKRS_MONITOR.nombreHoja);
    }
    const rangeToModify = newSheet.getRange(CONFIG_OKRS_MONITOR.rangoPais);
    rangeToModify.setValue(targetCountry.country);
    if (CONFIG_OKRS_MONITOR.ocultarFila) { newSheet.hideRows(CONFIG_OKRS_MONITOR.ocultarFila); }
    const protection = rangeToModify.protect().setDescription('Celda de País - Bloqueada por Script');
    const me = Session.getEffectiveUser();
    protection.removeEditors(protection.getEditors());
    protection.addEditor(me);
    Logger.log(`>>> [TAREA 3 OKRs Monitor] Proceso completado para ${targetCountry.country.toUpperCase()}.`);
  } catch (error) {
    Logger.log(`ERROR en [TAREA 3 OKRs Monitor] para ${targetCountry.country.toUpperCase()}: ${error.toString()}`);
  }
}

