// ##########################################################################################

const CONFIG_SUSTAINABILITY = {
  nombreHoja: "9 Sustainability",
  celdaPais: "C4"
};

function _sustainabilityWorker(targetCountry) {
  try {
    Logger.log(`--- [TAREA 9 SUSTAINABILITY] Iniciando para ${targetCountry.country.toUpperCase()} ---`);
    
    // 1. Abrir origen
    const sourceSpreadsheet = SpreadsheetApp.openById(SOURCE_SPREADSHEET_ID);
    const sourceSheet = sourceSpreadsheet.getSheetByName(CONFIG_SUSTAINABILITY.nombreHoja);
    if (!sourceSheet) throw new Error(`La hoja de origen '${CONFIG_SUSTAINABILITY.nombreHoja}' no fue encontrada.`);
    
    // 2. Abrir destino
    const targetSpreadsheet = SpreadsheetApp.openById(targetCountry.id);
    const existingSheet = targetSpreadsheet.getSheetByName(CONFIG_SUSTAINABILITY.nombreHoja);
    
    let newSheet;

    // 3. Reemplazar o Copiar hoja (MANTENIENDO EL ORDEN)
    if (existingSheet) {
      const originalIndex = existingSheet.getIndex(); // Guarda la posición actual
      targetSpreadsheet.deleteSheet(existingSheet);
      newSheet = sourceSheet.copyTo(targetSpreadsheet);
      newSheet.setName(CONFIG_SUSTAINABILITY.nombreHoja);
      targetSpreadsheet.setActiveSheet(newSheet);
      targetSpreadsheet.moveActiveSheet(originalIndex); // Restaura la posición
    } else {
      newSheet = sourceSheet.copyTo(targetSpreadsheet);
      newSheet.setName(CONFIG_SUSTAINABILITY.nombreHoja);
    }

    // 4. Escribir el País en la celda configurada y bloquearla
    const celdaPais = newSheet.getRange(CONFIG_SUSTAINABILITY.celdaPais);
    celdaPais.setValue(targetCountry.country);

    // ---- INICIO DEL BLOQUEO ----
    // Creamos la protección para la celda C4
    const proteccion = celdaPais.protect().setDescription('Bloqueo automático de celda de país');
    
    // Removemos a los demás editores para que solo tú (o la cuenta que ejecuta el script) puedas editarla
    const editores = proteccion.getEditors();
    proteccion.removeEditors(editores);
    
    // Si manejas Google Workspace corporativo, bloquea el acceso de edición a nivel dominio
    if (proteccion.canDomainEdit()) {
      proteccion.setDomainEdit(false);
    }
    // ---- FIN DEL BLOQUEO ----

    Logger.log(`>>> [TAREA 9 SUSTAINABILITY] Proceso completado y celda bloqueada para ${targetCountry.country.toUpperCase()}.`);
  } catch (error) {
    Logger.log(`ERROR en [TAREA 9 SUSTAINABILITY] para ${targetCountry.country.toUpperCase()}: ${error.toString()}`);
  }
}

