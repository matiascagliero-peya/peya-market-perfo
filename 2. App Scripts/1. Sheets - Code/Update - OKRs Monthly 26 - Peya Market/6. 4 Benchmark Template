// CONFIGURACIÓN
const ID_MASTER_BENCHMARK = "1H_gDXL9IQ9HCHSAzzDT8oGBNwPIw4rHmbjtqcqKJikc"; 
const NOMBRE_HOJA_BENCHMARK = "4 Benchmark Template";

// --- FUNCIÓN MAESTRA (WORKER) ---
function _workerBenchmark(pais) {
  if (!pais) { Logger.log("❌ Error: País no definido."); return; }

  try {
    Logger.log(`🔵 [TAREA 4] Procesando: ${pais.country}...`);

    // 1. ABRIR MASTER
    const ssMaster = SpreadsheetApp.openById(ID_MASTER_BENCHMARK);
    const hojaOrigen = ssMaster.getSheetByName(NOMBRE_HOJA_BENCHMARK);
    if (!hojaOrigen) throw new Error(`No existe la hoja '${NOMBRE_HOJA_BENCHMARK}' en el Master.`);

    // 2. ABRIR DESTINO
    const ssDestino = SpreadsheetApp.openById(pais.id);

    // 3. LIMPIEZA Y CAPTURA DE POSICIÓN
    let indiceOriginal = null; // Variable para guardar la posición
    const hojaVieja = ssDestino.getSheetByName(NOMBRE_HOJA_BENCHMARK);
    
    if (hojaVieja) {
      try {
        // --- NUEVO: Guardamos el índice (posición) antes de borrar ---
        indiceOriginal = hojaVieja.getIndex(); 
        
        // Renombramos a BASURA antes de borrar para evitar conflictos de nombre
        hojaVieja.setName("BASURA_BENCH_" + new Date().getTime());
        ssDestino.deleteSheet(hojaVieja);
      } catch (e) {
        hojaVieja.hideSheet(); // Si no se puede borrar, se oculta
      }
    }

    // 4. COPIAR Y RENOMBRAR
    const nuevaHoja = hojaOrigen.copyTo(ssDestino);
    nuevaHoja.setName(NOMBRE_HOJA_BENCHMARK);

    // 5. RESTAURAR POSICIÓN ORIGINAL
    // Si existía una hoja previa, movemos la nueva a ese lugar.
    if (indiceOriginal !== null) {
        ssDestino.setActiveSheet(nuevaHoja);
        ssDestino.moveActiveSheet(indiceOriginal);
    }

    Logger.log(`   ✅ ${pais.country} OK.`);

  } catch (e) {
    Logger.log(`   🔴 ERROR en ${pais.country}: ${e.message}`);
  }
}

