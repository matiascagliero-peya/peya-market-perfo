// He cambiado el nombre de la constante para evitar conflictos
const CONFIG_BENCHMARK_V2 = {
  nombreHoja: "3 Benchmark LATAM"
};

// He cambiado el nombre del Worker a _V2
function _benchmarkLatamWorker_V2(targetCountry) {
  try {
    Logger.log(`--- [TAREA BENCHMARK LATAM V2] Iniciando para ${targetCountry.country.toUpperCase()} ---`);
    
    // 1. Abrir origen
    const sourceSpreadsheet = SpreadsheetApp.openById(SOURCE_SPREADSHEET_ID);
    const sourceSheet = sourceSpreadsheet.getSheetByName(CONFIG_BENCHMARK_V2.nombreHoja);
    
    if (!sourceSheet) throw new Error(`La hoja de origen '${CONFIG_BENCHMARK_V2.nombreHoja}' no fue encontrada.`);
    
    // 2. Abrir destino
    const targetSpreadsheet = SpreadsheetApp.openById(targetCountry.id);
    const existingSheet = targetSpreadsheet.getSheetByName(CONFIG_BENCHMARK_V2.nombreHoja);
    
    let newSheet;

    // 3. Reemplazar o Copiar hoja
    if (existingSheet) {
      const originalIndex = existingSheet.getIndex();
      targetSpreadsheet.deleteSheet(existingSheet);
      
      newSheet = sourceSheet.copyTo(targetSpreadsheet);
      newSheet.setName(CONFIG_BENCHMARK_V2.nombreHoja);
      
      targetSpreadsheet.setActiveSheet(newSheet);
      targetSpreadsheet.moveActiveSheet(originalIndex);
    } else {
      newSheet = sourceSheet.copyTo(targetSpreadsheet);
      newSheet.setName(CONFIG_BENCHMARK_V2.nombreHoja);
    }

    Logger.log(`>>> [TAREA BENCHMARK LATAM V2] Proceso completado para ${targetCountry.country.toUpperCase()}.`);
  } catch (error) {
    Logger.log(`ERROR en [TAREA BENCHMARK LATAM V2] para ${targetCountry.country.toUpperCase()}: ${error.toString()}`);
  }
}

