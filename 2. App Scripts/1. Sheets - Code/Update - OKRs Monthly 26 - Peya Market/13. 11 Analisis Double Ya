const CONFIG_ANALISIS_DOUBLE_YA = {
  nombreHoja: "11 Analisis Double Ya",
  celdaPais: "D6"
};

function _analisisDoubleYaWorker(targetCountry) {
  try {
    Logger.log(`--- [TAREA 11 ANALISIS DOUBLE YA] Iniciando para ${targetCountry.country.toUpperCase()} ---`);
    
    // 1. Abrir origen
    const sourceSpreadsheet = SpreadsheetApp.openById(SOURCE_SPREADSHEET_ID);
    const sourceSheet = sourceSpreadsheet.getSheetByName(CONFIG_ANALISIS_DOUBLE_YA.nombreHoja);
    if (!sourceSheet) throw new Error(`La hoja de origen '${CONFIG_ANALISIS_DOUBLE_YA.nombreHoja}' no fue encontrada.`);
    
    // 2. Abrir destino
    const targetSpreadsheet = SpreadsheetApp.openById(targetCountry.id);
    const existingSheet = targetSpreadsheet.getSheetByName(CONFIG_ANALISIS_DOUBLE_YA.nombreHoja);
    
    let newSheet;

    // 3. Reemplazar o Copiar hoja (MANTENIENDO EL ORDEN)
    if (existingSheet) {
      const originalIndex = existingSheet.getIndex(); // Guarda la posición actual
      targetSpreadsheet.deleteSheet(existingSheet);
      newSheet = sourceSheet.copyTo(targetSpreadsheet);
      newSheet.setName(CONFIG_ANALISIS_DOUBLE_YA.nombreHoja);
      targetSpreadsheet.setActiveSheet(newSheet);
      targetSpreadsheet.moveActiveSheet(originalIndex); // Restaura la posición
    } else {
      newSheet = sourceSheet.copyTo(targetSpreadsheet);
      newSheet.setName(CONFIG_ANALISIS_DOUBLE_YA.nombreHoja);
    }

    // 4. Escribir el País en la celda configurada y bloquearla
    const celdaPais = newSheet.getRange(CONFIG_ANALISIS_DOUBLE_YA.celdaPais);
    celdaPais.setValue(targetCountry.country);

    // ---- INICIO DEL BLOQUEO ----
    // Creamos la protección para el rango (celda D6)
    const proteccion = celdaPais.protect().setDescription('Bloqueo automático de celda de país');
    
    // Obtenemos la lista de editores actuales de esa protección y los removemos
    // (Esto dejará automáticamente solo al propietario/ejecutor del script)
    const editores = proteccion.getEditors();
    proteccion.removeEditors(editores);
    
    // Si estás en un entorno Google Workspace corporativo, evita que otros miembros del dominio editen
    if (proteccion.canDomainEdit()) {
      proteccion.setDomainEdit(false);
    }
    // ---- FIN DEL BLOQUEO ----

    Logger.log(`>>> [TAREA 11 ANALISIS DOUBLE YA] Proceso completado y celda bloqueada para ${targetCountry.country.toUpperCase()}.`);
  } catch (error) {
    Logger.log(`ERROR en [TAREA 11 ANALISIS DOUBLE YA] para ${targetCountry.country.toUpperCase()}: ${error.toString()}`);
  }
}

